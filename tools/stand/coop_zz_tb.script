-- Stand only (temp/stand/taskboard*.ps1 puts it into the stand's gamedata and takes it away). 2026-11-18, complaint
-- "на раздельных нет квестов": what does the PDA task board of a client get? A process started with `-coop_probe tb`
-- asks for the board the way the PDA's Refresh button does, 35 s after its session is live, and writes "[tb] ..." lines.
-- Every other machine that has this file (the host, a world server, a map server) only logs each task generation it runs.

local ASK_MS, GIVE_UP_MS = 35000, 75000
local ROLE
local started, asked, finished

local function out(fmt, ...)
	local ok, s = pcall(string.format, fmt, ...)
	printf("%s", "[tb] " .. (ok and s or tostring(fmt)))
end

local function flush()
	pcall(function() get_console():execute("flush") end)
end

local function npc_line(o)
	local ok, s = pcall(function()
		local comm = "?"
		pcall(function() comm = tostring(character_community(o)) end)
		return string.format("%d %s [%s] community %s, %.0f m", o:id(), o:name(), o:section(), comm,
			db.actor and o:position():distance_to(db.actor:position()) or -1)
	end)
	return ok and s or "? (a line of this NPC failed)"
end

local function count(t)
	local n = 0
	if type(t) == "table" then for _ in pairs(t) do n = n + 1 end end
	return n
end

local function board_state(npcs)
	local pt, a = pda_taskboard, axr_task_manager
	out("board rows now: %d (prepared_tasks_data)", count(pt and pt.prepared_tasks_data))
	local with, total = 0, 0
	for _, npc in ipairs(npcs) do
		local list = a and a.available_tasks and a.available_tasks[npc:id()]
		local n = type(list) == "table" and #list or 0
		total = total + n
		if n > 0 then
			with = with + 1
			out("  tasks of %d: %s", npc:id(), table.concat(list, ","))
		end
	end
	out("available tasks: %d task(s) of %d NPC(s) out of %d near", total, with, #npcs)
	pcall(function() coop_quests_offer.print_status() end)
	flush()
end

local function ask()
	local qc = coop_quests_core
	if not (qc and qc.client_live and qc.client_live()) then return false end
	local pt = pda_taskboard
	if not (pt and pt.get_nearby_npcs) then
		out("! no pda_taskboard here")
		return true
	end
	local npcs = pt.get_nearby_npcs()
	out("level %s, NPCs the board finds near the player: %d", tostring(level.name()), #npcs)
	for i = 1, math.min(#npcs, 14) do out("  %s", npc_line(npcs[i])) end
	flush()
	local t0 = time_global()
	local ok, res = pcall(coop_quests_offer.request_offers, npcs, function()
		out("the batch is over after %d ms", time_global() - t0)
		local okr, err = pcall(pt.refresh_tasks)
		out("refresh_tasks: %s", okr and "ok" or ("! " .. tostring(err)))
		board_state(npcs)
		finished = true
	end, true)
	out("request_offers: %s", ok and ("started " .. tostring(res)) or ("! " .. tostring(res)))
	flush()
	asked = npcs
	return true
end

local function actor_on_update()
	if ROLE ~= "tb" or finished then return end
	local now = time_global()
	if not started then
		local qc = coop_quests_core
		if not (qc and qc.client_live and qc.client_live()) then return end
		started = now
		out("clock: the session is live here")
		return
	end
	if not asked then
		if now - started < ASK_MS then return end
		local ok, res = pcall(ask)
		if not ok then
			out("! %s", tostring(res))
			finished = true
		end
		return
	end
	if now - started > GIVE_UP_MS then
		out("! no end of the batch %d ms after the session went live", now - started)
		board_state(asked)
		finished = true
	end
end

-- every machine: what each task generation gives, and where it runs
local function wrap_generation()
	local a = axr_task_manager
	if not (type(a) == "table" and type(a.generate_available_tasks) == "function") then return end
	local orig = a.generate_available_tasks
	a.generate_available_tasks = function(npc, is_sim, ...)
		local id, name = -1, "?"
		pcall(function() id, name = npc:id(), npc:name() end)
		local st = db.storage and db.storage[id]
		local res = { pcall(orig, npc, is_sim, ...) }
		local list = a.available_tasks and a.available_tasks[id]
		out("generation for %d %s, sim %s: %s, %d task(s)%s; storage %s (far %s, ini %s, rand %s)", id, name, tostring(is_sim),
			res[1] and "ok" or ("! " .. tostring(res[2])), type(list) == "table" and #list or 0,
			type(list) == "table" and #list > 0 and (": " .. table.concat(list, ",")) or "",
			st and "yes" or "no", tostring(st and st.far), tostring(st and st.ini ~= nil), tostring(st and st.dyn_quest_rand))
		if not res[1] then error(res[2], 0) end
		return unpack(res, 2)
	end
	out("task generation is logged on this machine")
end

function on_game_start()
	local ok, line = pcall(command_line)
	ROLE = ok and type(line) == "string" and line:match("%-coop_probe%s+(%w+)") or nil
	pcall(wrap_generation)
	if ROLE == "tb" then
		RegisterScriptCallback("actor_on_update", actor_on_update)
		out("armed: the board is asked %d s after the session goes live", ASK_MS / 1000)
	end
end
