-- Dev 57 SS only (A-S6J, S5 feed lines). Two players of a server world start on one map. The first takes a real level exit,
-- the second follows through the same exit a little later. Each machine's engine writes its feed lines to the log
-- ("[srv] feed: '<nick>' went to <level>" / "came from <level>"); feed_server.ps1 reads them. This probe only moves.
local FIRST, SECOND = "feedfirst", "feedsecond"
local START_KEY = "stand.feed_from" -- the session stash survives this player's level load
local FOLLOW_MS = 20000 -- the second goes this long after the first left the map
local role, next_poll, finished = nil, 0, false
local travel, other_left_at

local function out(fmt, ...)
	printf("%s", "[feed] " .. string.format(fmt, ...))
	get_console():execute("flush")
end

local function player(nick)
	for _, p in ipairs(coop.players()) do
		if not p.is_self and p.nick == nick then return p end
	end
end

local function nearest_exit(actor)
	local best, distance
	local from = actor:position()
	for id = 1, 65534 do
		local obj = level.object_by_id(id)
		if obj and (obj:clsid() == clsid.level_changer or obj:clsid() == clsid.level_changer_s) then
			local pos = obj:position()
			local d = pos:distance_to(from)
			if not distance or d < distance then best, distance = pos, d end
		end
	end
	return best
end

local function beside_exit(exit, from)
	local angle = math.atan2(from.z - exit.z, from.x - exit.x)
	for _, r in ipairs({ 12, 16, 20 }) do
		for i = 0, 15 do
			local a = angle + i * math.pi / 8
			local near = vector():set(exit.x + r * math.cos(a), exit.y, exit.z + r * math.sin(a))
			local node = level.vertex_id(near)
			if node and node < 0xffffffff then
				local pos = level.vertex_position(node)
				local d = pos:distance_to(exit)
				if d >= 8 and d <= 24 and math.abs(pos.y - exit.y) < 6 then return pos end
			end
		end
	end
end

-- May this player leave now? The first: when the second stands on his map. The second: FOLLOW_MS after the first left it.
local function may_go(now)
	local other = player(role == FIRST and SECOND or FIRST)
	if not other then return false end
	local where = coop_mode.where(other.id)
	if role == FIRST then return where == "here" end
	if where ~= "away" then
		other_left_at = nil
		return false
	end
	other_left_at = other_left_at or now
	return now - other_left_at >= FOLLOW_MS
end

local function move(now, actor)
	local here = level.name()
	local from = coop.stash_get(START_KEY)
	if type(from) == "string" and from ~= "" and from ~= here then
		finished = true
		out("%s arrived %s -> %s", role == FIRST and "first" or "second", from, here)
		return
	end
	if not travel then
		if not may_go(now) then return end
		local target = nearest_exit(actor)
		local beside = target and beside_exit(target, actor:position())
		if not beside or not coop.stash_set(START_KEY, here) then
			finished = true
			out("FAIL: %s could not prepare a level exit from %s", role, here)
			return
		end
		actor:set_actor_position(vector():set(beside.x, beside.y + 0.3, beside.z))
		travel = { target = target, enter_at = now + 10000 }
		out("%s preparing exit from %s", role, here)
		return
	end
	if now < travel.enter_at then return end
	if not travel.confirm_at then
		local p = travel.target
		actor:set_actor_position(vector():set(p.x, p.y + 0.2, p.z))
		travel.confirm_at = now + 2000
	elseif now >= travel.confirm_at then
		get_console():execute("coop_transition_confirm")
		travel.confirm_at = now + 2500
	end
end

local function update()
	local actor = db.actor
	if finished or not (actor and coop.is_live() and coop_mode.is_player_mirror()) then return end
	local now = time_global()
	if now < next_poll then return end
	next_poll = now + 250
	move(now, actor)
end

function on_game_start()
	role = command_line():match("%-coop_probe%s+(%w+)")
	if role == FIRST or role == SECOND then RegisterScriptCallback("actor_on_update", update) end
end
