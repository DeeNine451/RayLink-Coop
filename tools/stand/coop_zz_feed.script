-- Dev 57 SS only (A-S6J, S5 feed lines). Two players of a server world on one map. The first takes a real level exit,
-- the second follows through the same exit a little later. Each machine's engine writes its feed lines to the log
-- ("[srv] feed: '<nick>' went to <level>" / "came from <level>"); feed_server.ps1 reads them. This probe only moves.
-- A Server world starts each new character at any start of its faction (coop_menu_char.host_start; stalker: three maps). A
-- first who joined on another map goes once to the second's map (the setup trip) and chooses his exit from the second's
-- start there, so both take the same exit. The first moves: the second stays live where he started until the test.
local FIRST, SECOND = "feedfirst", "feedsecond"
local START_KEY = "stand.feed_from" -- the session stash survives this player's level load
local FOLLOW_MS = 20000 -- the second goes this long after the first left the map
local GATHER_KEY = "stand.feed_gather" -- the map of the first's setup trip, kept over his level load
local GATHER_MS = 60000 -- after the setup trip the second must be on the first's map within this long
local FACTION = "stalker" -- feed_server.ps1's stage and -coop_autochoose
-- feed_server.ps1 writes "go" here once the second's log says his join is complete (he is live and his world is up: his feed
-- watch compares only then, srv/coop_srv_join.cpp feed_frame). b57f-b57i: "here" is the second's character on the
-- first's map, which the world places while the second's machine still loads; the first left then, the second's feed first saw
-- him on the other map (a first sight makes no line, xrCoop/srv/coop_srv_feed_rules.h Watch::step) and "went to" never came.
local STEP_FILE = "zz_feed_step.txt"
-- After his arrival a player only waits while feed_server.ps1 reads the lines: a flushed pulse this often keeps his log current.
-- b57i: one of the two players there (the scenario named only the pid) ended in a heap corruption (0xC0000374) minutes
-- later; both logs lost their unflushed last 4 KB (the CRT buffer): the first's last minute of play is in no log.
local PULSE_MS = 5000
local role, next_poll, finished = nil, 0, false
local travel, other_left_at, gathering, gathered_at, origin, step_path, next_pulse

local function out(fmt, ...)
	printf("%s", "[feed] " .. string.format(fmt, ...))
	get_console():execute("flush")
end

local function player(nick)
	for _, p in ipairs(coop.players()) do
		if not p.is_self and p.nick == nick then return p end
	end
end

local function nearest_exit(from)
	local best, distance
	for id = 1, 65534 do
		local obj = level.object_by_id(id)
		if obj and (obj:clsid() == clsid.level_changer or obj:clsid() == clsid.level_changer_s) then
			local pos = obj:position()
			local d = pos:distance_to(from)
			if not distance or d < distance then best, distance = pos, d end
		end
	end
	return best
end

local function beside_exit(exit, from)
	local angle = math.atan2(from.z - exit.z, from.x - exit.x)
	for _, r in ipairs({ 12, 16, 20 }) do
		for i = 0, 15 do
			local a = angle + i * math.pi / 8
			local near = vector():set(exit.x + r * math.cos(a), exit.y, exit.z + r * math.sin(a))
			local node = level.vertex_id(near)
			if node and node < 0xffffffff then
				local pos = level.vertex_position(node)
				local d = pos:distance_to(exit)
				if d >= 8 and d <= 24 and math.abs(pos.y - exit.y) < 6 then return pos end
			end
		end
	end
end

-- The start of the world's faction on this map (where a new character of it is put, coop_menu_char.host_start).
local function start_of(map)
	local ok, starts = pcall(coop_menu_char.faction_starts, FACTION, true)
	if not ok or type(starts) ~= "table" then return nil end
	for _, s in ipairs(starts) do
		if s.image == map then return vector():set(s.x, s.y, s.z) end
	end
end

-- The first, before the test: true while the second is not on his map. Apart, he goes once to the second's map by the stock
-- debug trip (JumpToLevel: the server's real move decision). There he takes his exit from the second's start (`origin`): the
-- second still stands there, and his nearest exit is the same one.
local function gather(now, here)
	local other = player(SECOND)
	if not other then return true end
	local where = coop_mode.where(other.id)
	local went = coop.stash_get(GATHER_KEY)
	local gathered = type(went) == "string" and went ~= ""
	if where == "here" then
		if gathered and not origin then
			origin = start_of(here)
			if not origin then
				finished = true
				out("FAIL: the first found no %s start on %s", FACTION, here)
				return true
			end
		end
		return false
	end
	if gathering then return true end -- the trip is under way
	if gathered then
		gathered_at = gathered_at or now
		if went ~= here or now - gathered_at >= GATHER_MS then
			finished = true
			out("FAIL: the first did not join the second (went to %s, is on %s, the second is %s)", went, here, where)
		end
		return true
	end
	if where ~= "away" then return true end -- the second is not placed on a map yet
	local lid = coop.levels.level_of_player(other.id)
	local map = lid and coop.levels.level_name(lid)
	if not map or map == here then return true end
	gathering = true
	if not coop.stash_set(GATHER_KEY, map) then
		finished = true
		out("FAIL: the first could not keep the map of his setup trip")
		return true
	end
	out("first joins the second on %s (start %s)", map, here)
	if not JumpToLevel(map) then
		finished = true
		out("FAIL: the first could not request %s", map)
	end
	return true
end

-- The scenario's word (STEP_FILE) that the second is live.
local function released()
	step_path = step_path or getFS():update_path("$fs_root$", STEP_FILE)
	local file = io.open(step_path, "r")
	if not file then return false end
	local step = file:read("*l")
	file:close()
	return step == "go"
end

-- May this player leave now? The first: when the second stands on his map and is live there (the scenario's word). The second:
-- FOLLOW_MS after the first left it.
local function may_go(now)
	local other = player(role == FIRST and SECOND or FIRST)
	if not other then return false end
	local where = coop_mode.where(other.id)
	if role == FIRST then return where == "here" and released() end
	if where ~= "away" then
		other_left_at = nil
		return false
	end
	other_left_at = other_left_at or now
	return now - other_left_at >= FOLLOW_MS
end

local function move(now, actor)
	local here = level.name()
	local from = coop.stash_get(START_KEY)
	if type(from) == "string" and from ~= "" and from ~= here then
		finished = true
		out("%s arrived %s -> %s", role == FIRST and "first" or "second", from, here)
		return
	end
	if not travel then
		if role == FIRST and gather(now, here) then return end
		if not may_go(now) then return end
		local from_pos = origin or actor:position()
		local target = nearest_exit(from_pos)
		local beside = target and beside_exit(target, from_pos)
		if not beside or not coop.stash_set(START_KEY, here) then
			finished = true
			out("FAIL: %s could not prepare a level exit from %s", role, here)
			return
		end
		actor:set_actor_position(vector():set(beside.x, beside.y + 0.3, beside.z))
		travel = { target = target, enter_at = now + 10000 }
		out("%s preparing exit from %s", role, here)
		return
	end
	if now < travel.enter_at then return end
	if not travel.confirm_at then
		local p = travel.target
		actor:set_actor_position(vector():set(p.x, p.y + 0.2, p.z))
		travel.confirm_at = now + 2000
	elseif now >= travel.confirm_at then
		get_console():execute("coop_transition_confirm")
		travel.confirm_at = now + 2500
	end
end

local function pulse(now, actor)
	if next_pulse and now < next_pulse then return end
	next_pulse = now + PULSE_MS
	local health = type(actor.health) == "number" and string.format("%.3f", actor.health) or "?"
	out("pulse: %s on %s, health %s", role, level.name(), health)
end

local function update()
	local actor = db.actor
	if not (actor and coop.is_live() and coop_mode.is_player_mirror()) then return end
	local now = time_global()
	if finished then
		pulse(now, actor)
		return
	end
	if now < next_poll then return end
	next_poll = now + 250
	move(now, actor)
end

function on_game_start()
	role = command_line():match("%-coop_probe%s+(%w+)")
	if role == FIRST or role == SECOND then RegisterScriptCallback("actor_on_update", update) end
end
