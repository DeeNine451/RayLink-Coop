;; Anomaly Coop - the Brain Scorcher for two sides (gamedata\scripts\coop_scorcher.script), DLTX beside the stock bunker_primary_switcher.ltx.
;; Outside a co-op world with split levels the first branch of every changed line is the stock outcome (and a missing
;; coop_* condition is skipped by xr_logic, which lands on that first branch too).

![ph_button@rad_on]
on_press = {!coop_split_mode} ph_button@rad_off %+bar_deactivate_radar_done%, {=coop_scorcher_can_off} ph_button@rad_off %+bar_deactivate_radar_done =coop_scorcher_flipped(off)%, %=coop_scorcher_refused%

![ph_button@rad_off]
on_press = {!coop_split_mode}, {=coop_scorcher_can_on} ph_button@rad_on %-bar_deactivate_radar_done =coop_scorcher_flipped(on)%, %=coop_scorcher_refused%
