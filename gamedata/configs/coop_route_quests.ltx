; Anomaly Coop - callback routes of the quests group (W4), read by the engine after configs\coop_route.ltx (same
; sections and rules, see there). Migrated from coop_domains_quests.ltx (F2 T10). coop_tasks / coop_quests_* are view
; (coop_*).

[route_scripts]
; iTheon's PDA taskboard (lizzardman's version): its tab is opened through z_taskboard_overrides (on_game_load); a
; client's board rows come from the host's offers (coop_quests_offer), so the board's own fake conversations do not
; run on a client
pda_taskboard                    = view
pda_taskboard_mcm                = view
z_taskboard_overrides            = view
; Dynamic Anomalies Overhaul: its anomaly lifecycle spawns / releases world objects. The flash mine's per-player part
; runs on clients through coop_quests_story (the time jump is the host's).
drx_da_main                      = host
grok_artefacts_random_spawner    = host   ; reads drx_da_main's tables, which are the host's: an error a client on every run
drx_da_main_artefacts            = host
drx_da_main_artefacts_movement   = host
; the kills of these run on the world server by the death relay (coop_quests_far), not on the map server of the level
tasks_brain_game                 = host
tasks_dead_night                 = host
tasks_gambling_with_life         = host
tasks_vengence_amplified         = host

; split levels: a level's anomalies are made where it is led, from the same tables; what happens to all of them after an emission is
; decided once, on the world server (coop_mods_dao)
[route_pairs]
actor_on_first_update@drx_da_main = level
actor_on_update@drx_da_main       = level
monster_on_before_hit@drx_da_main = level
npc_on_item_take@drx_da_main      = level
on_game_load@drx_da_main          = level
on_option_change@drx_da_main      = level
time_event@drx_da_main            = level
on_enemy_eval@guards_spawner      = level
actor_on_interaction@coop_levels_tables = host ; drx_da_main's handler in a wrapper of ours: the roll after an emission stays one
