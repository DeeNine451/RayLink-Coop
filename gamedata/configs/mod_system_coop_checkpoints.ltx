; Build 57 (owner 2026-11-18): the bases whose bed is the checkpoint (see "base" at the top). One row per stock sleep zone
; of [coop_rest_zones] that stands in a real base: <sleep zone> = <radius of its ground in m>, <owner community>[,
; <owner>...] (up to 6) or none. A base is hostile to a player only when it has an owner the game knows and every one of
; them is his enemy; an owner that is no community of the game is logged once and not counted. 15 rows: the 25 stock sleep zones less the five secret hideouts below and the five wilderness camps
; (ros_vagon_sleep, val_vagon_sleep, val_abandoned_house_sleep, ds_farmhouse_sleep, mil_smart_terran_2_4_sleep: no base,
; they stay rest places of [coop_rest_zones]). "none" is never hostile; an owner is hostile to a player whose community + standing with it is an enemy's
; (relation + goodwill <= -1000, the stock game_relations.ENEMIES). The five secret hideouts (esc_secret_sleep,
; actor_surge_hide_2, pol_secret_sleep, pri_room27_sleep, rad_sleep_room) are no bases. Owners from the game's own data
; (configs\misc\simulation_objects_props.ltx of the G.A.M.M.A. stand: the factions of the camp's smart terrain, checked by
; the lead 2026-11-18) and the zone names; gar_angar_sleep: its holder is not known, "none".
; Mod packs change rows or add bases with DLTX (![coop_bases]).
[coop_bases]
esc_basement_sleep_area     = 50, stalker, csky, ecolog   ; Cordon, Rookie Village (esc_smart_terrain_2_12)
bar_actor_sleep_zone        = 50, dolg      ; Rostok, the Bar (every base smart of l05_bar has dolg; bar_dolg_*, bar_zastava* only dolg)
zat_a2_sr_sleep             = 50, stalker, csky, dolg     ; Zaton, Skadovsk (zat_stalker_base_smart)
jup_a6_sr_sleep             = 50, stalker, freedom, ecolog   ; Jupiter, Yanov (jup_a6)
mar_a3_sr_sleep             = 50, csky      ; Great Swamps, Clear Sky base (mar_smart_terrain_base: csky 2, the others 1)
yan_bunker_sleep_restrictor = 50, stalker, csky, ecolog   ; Yantar, the scientists' bunker (yan_smart_terrain_6_4)
mil_freedom_sleep           = 50, freedom   ; Army Warehouses, Freedom base (its name; mil_smart_terrain_7_7: freedom 5 only)
gar_dolg_sleep              = 50, dolg      ; Garbage, the Duty post (its name)
gar_angar_sleep             = 50, none      ; Garbage, the hangar (gar_smart_terrain_5_2: its holder is not known)
agr_army_sleep              = 50, army      ; Agroprom, the institute (its name; agr_smart_terrain_1_6 and its near_* smarts: army only)
agr_sr_sleep_wagon          = 50, stalker, csky, ecolog   ; Agroprom, the stalker camp (agr_smart_terrain_4_4*)
agr_sr_sleep_tunnel         = 50, stalker, csky, ecolog   ; Agroprom, the stalker camp (dropped when it overlaps the wagon)
cit_merc_sleep              = 50, killer    ; Dead City, the mercenaries (its name; cit_killers: killer 5 only)
pri_a16_sr_sleep            = 50, stalker, bandit, csky, dolg, freedom   ; Pripyat, the stalkers' base (pri_a16)
pri_monolith_sleep          = 50, monolith  ; Pripyat, Monolith (its name; smart pri_monolith)

; Build 57 round 2 (the lead 2026-11-18; the owner's "for the bases that are not covered, just put the point at the place of
; the first spawn on that base" means real bases without a sleeping place, not every start location). Opt-in: only a start
; location of base_start_locations named here is a base: <start location id> = <owner community>[, <owner>...] (up to 6)
; or none. Its owners come from this row (the faction that holds the place in the game), never from the factions whose
; new-game lists name it; its point from its own section in base_start_locations. A row whose id has no section there is
; logged once and skipped; an owner that is no community is logged once and counted as none (never an assert). Curated by
; the lead. Some of them may fall on the ground of a zone base of [coop_bases]: those make no base of their own, and the log
; of the host (world server, map server) names them when a level is loaded ("start location(s) of [coop_start_bases] on
; the ground of another base of this level"). Mod packs change rows with DLTX (![coop_start_bases]).
