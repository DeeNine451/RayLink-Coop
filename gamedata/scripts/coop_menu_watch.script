--[[
	Anomaly Coop - what the next game has to say (gamedata\scripts\coop_menu_watch.script)

	Two live bugs of 2026-10-31 the code alone did not prove. This file only speaks: lines in the log, no key and no window
	behaves differently because of it.

	"I can no longer click anywhere in the inventory" (the host, noticed after a load). GAMMA's inventory is the Lua window
	ui_inventory, and a click has three ways of not getting there:
		level_input.on_key_press       a script's on_before_key_press takes the key before the window sees it
		Overlapped_UI                  another registered window stops UIInventory:Update, so no cell is under the pointer
		game.only_movekeys_allowed     Inventory Anti-Closing turns off the drag, the double click and the context menu; the
		                               flag is one global of the engine and a mod's animation sets it
	A clean inventory is not worth a line: if the bug comes back and none of these is in the log, the cause is elsewhere.

	"Esc, and no way back from the main menu" (a client, then the host). The stock line returns to the game only for a living
	actor, so every Esc of a session goes into the log, with what that line is going to do.
--]]

local pairs, pcall, rawget, tostring, type = pairs, pcall, rawget, tostring, type

local MAX_CLICK_LINES = 3
local clicks_said = 0

local function log(fmt, ...)
	printf("[coop-menu] " .. fmt, ...)
end

-- What keeps clicks away from the inventory right now: a list of words, empty when nothing does.
function blocks()
	local why = {}
	local gm = rawget(_G, "game")
	if gm and gm.only_movekeys_allowed and gm.only_movekeys_allowed() then
		why[#why + 1] = "movement keys only"
	end
	local fdda = rawget(_G, "liz_fdda_input_manager")
	if type(fdda) == "table" and fdda.is_input_disabled then
		why[#why + 1] = "an animation holds the input"
	end
	local guis = rawget(_G, "_GUIs")
	if type(guis) == "table" then
		for name in pairs(guis) do
			if name ~= "UIInventory" and name ~= "Dialog" then -- the stock lets a talk stay under the inventory
				why[#why + 1] = "window " .. tostring(name)
			end
		end
	end
	return why
end

local function on_gui_show(name)
	if name ~= "UIInventory" then return end
	local why = blocks()
	if #why > 0 then
		log("! the inventory opens with its clicks in danger: %s", table.concat(why, ", "))
	end
end

local function inventory_open()
	local guis = rawget(_G, "_GUIs")
	return type(guis) == "table" and guis.UIInventory ~= nil
end

-- The engine looks the function up by name on every key, so the wrapper is in place from here on.
local function watch_clicks()
	local ok, stock = pcall(function() return level_input.on_key_press end)
	if not (ok and stock) then return end
	level_input.on_key_press = function(dik, bind, dis)
		local taken = stock(dik, bind, dis)
		if taken and dik == DIK_keys.MOUSE_1 and clicks_said < MAX_CLICK_LINES and inventory_open() then
			clicks_said = clicks_said + 1
			log("! a click in the inventory was taken by a script (on_before_key_press, bind %s)", tostring(bind))
		end
		return taken
	end
end

local function on_menu_key(dik, action, menu, in_level)
	if action ~= ui_events.WINDOW_KEY_PRESSED or dik ~= DIK_keys.DIK_ESCAPE or not in_level then return end
	if not coop.is_active() then return end
	local actor = rawget(_G, "db") and db.actor
	local alive = actor and actor:alive()
	log("Esc in the main menu of a session: actor %s, life %s, the menu %s", actor and (alive and "alive" or "dead") or "none",
		tostring(coop.life_of and coop.life_of(0)), alive and "closes" or "stays (the stock line)")
end

function on_game_start()
	if not rawget(_G, "coop") then return end -- an exe without co-op: nothing of this runs
	RegisterScriptCallback("GUI_on_show", on_gui_show)
	RegisterScriptCallback("main_menu_on_keyboard", on_menu_key)
	pcall(watch_clicks) -- on_game_start must not throw: axr_main runs them all in one loop
end
