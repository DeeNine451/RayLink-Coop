-- Ядро: без проверок режима (docs/MODES.md).
-- G16-3: ALQ parcel recipients include trader game objects (CEntityAlive).
-- Co-op supplies objects on the host; Server supplies them on the player's map.
-- Keep the mod's publication, alive/player guards and snapshot lifetime intact.

local installed = setmetatable({}, { __mode = "k" })

local function install_publication_filter()
	local mod = coop_mods_core.mod("coop_compat_alq")
	if not mod then return end
	local publish = coop_mods_core.find_local(mod, "publish_for")
	if type(publish) ~= "function" then
		error("ALQ publish_for unavailable; publication filter not installed")
	end
	if installed[publish] then return end

	-- Only this function and the iterator callback it creates see the extended
	-- predicate. Neither the mod namespace nor the global IsStalker is changed.
	local original_env = getfenv(publish)
	local env = setmetatable({}, { __index = original_env })
	local ok = coop_mods_core.wrap(env, "IsStalker", "alq.publish_for.IsStalker", function(orig)
		return function(obj, ...)
			local stalker = orig(obj, ...)
			if stalker or not coop_mods_core.active() then return stalker end
			local trader = original_env.IsTrader
			return type(trader) == "function" and trader(obj, ...) or false
		end
	end)
	if not ok then error("ALQ IsStalker unavailable; publication filter not installed") end
	setfenv(publish, env)
	installed[publish] = true
end

function on_game_start()
	local ok, err = pcall(install_publication_filter)
	if not ok then printf("! [coop_mods_alq] publication filter failed: %s", tostring(err)) end
end
