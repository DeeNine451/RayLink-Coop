-- Ядро: без проверок режима (docs/MODES.md)
--[[
	Anomaly Coop - the mode facade (gamedata\scripts\coop_mode.script), docs\MODES.md section 4 "Lua", step S4.
	Frozen contract: temp\b58\contracts\coop_mode_api.md (after the W0 gate it changes only through the lead).

	The Core never asks which mode it runs in. It asks this facade about a player, a level or its own actor, and the
	answer comes from the layer of the mode this process runs in:
	  hostplay  scripts\coop_hostplay_mode.script: the co-op (the host plays, everybody on one map)
	  srv       scripts\coop_srv_mode.script: the server (a world server without a player's map, map servers, and the
	            players' machines of such a world)
	Those two read the engine's predicates; this file never does. Before a layer is installed, and outside a session,
	the answers are those of "none" (single player: the stock game).

	Questions (call as coop_mode.x(...), no new file local in the caller: docs\MODES.md section 4):
		where(peer)          "here" | "away" | "joining": is that player's character on the map this process has
		decider(peer)        "this" | "other" | "nobody": who decides for that player's character
		actor_is_player()    this process's own actor is a player (false: a server's ghost)
		decides_world()      this process decides the world (offline, time, story, money, the save)
		leads_here()         this process leads the map it has loaded (objects, AI, physics)
		is_player_mirror()   this process is a player's machine: its objects are copies
		seat_plays(peer)     the seat of that peer plays a character (seat 0: is the host's seat a player)
		group_travels()      the group moves between maps together
		from_level(from)    the transport sender is a registered map-server bridge on the active Server world
		facts_of(peer)       { talking = bool|nil, partner = id|false|nil }: what the map server of that player's map
		                     reported of his body, where it is reported to this process (the world server); nil: the
		                     body is read here, or nobody reports it (F-BODY, A-S6-IF; the C++ twin is Mode::facts_of)
		hook(name)           a function of the server's scripts by its name (the list: docs\contracts\coop_mode_api.md
		                     section 7), or nil: the co-op and single player have none. Asked when it is needed, never kept
		far()                the far view (the server's coop_srv_quests_far, which looks at the maps of other processes),
		                     or the stub of the co-op and single player: no scope, everything runs here. Always a table
		                     with in_scope level_of_id order fallback with_level_of with_target at_home object note_fail
		                     print_status add_death_listener (a function the layer's view lacks is the stub's)
		writes(id)           R32 W1: this process writes the object (creates under it, releases it, changes it): the co-op host
		                     and single player always; a player's machine never; a world server or a map server by the writer
		                     rule (who leads the object's map, who holds its unit). A process that does not write it asks.
		presence(level, pos) R32 W10: the players around a place, {peer, ...}; nil: none to count here (single player: stock)
		op_done(op, answer)  R32 W7: an op that consumes or pays ran; the server puts its answer in the level journal (WP4),
		                     the co-op and single player keep it in the module's own save
		share_up(name, get, set[, every])    a table a map server tells the world server (F-SHARE): kept by
		share_down(name, get, set[, every])  coop_quests_core in every process, carried by the server's share
		                     (coop_srv_levels_share) only; nothing carries it in the co-op. True when kept
	Delivery:
		on_level_request(name, fn[, door])  a player's request to the logic of the map he stands on, event `name`:
		                     fn(payload, from, relayed) runs on the process that leads that map, `from` = the player;
		                     door(payload, from) -> true runs first on the process the player reached (false drops it);
		                     a request another process passed on (relayed) has been through its door there
		publish(verb, t)     world data this process changed, to those who keep the world: event `verb`, t a flat table
		                     (coop_main.encode) or a string; true when it was sent
	Layers:
		install(layer)       a mode's layer (the table described in the contract); true when accepted
		uninstall(name)      removes the layer "hostplay" or "srv"
		when_srv(fn[, layer]) fn() runs once in this process, as soon as the srv layer answers (at once if it does now).
		                     The only place a srv script registers callbacks, condition functions, events and saves
		                     (check_layers L9). `layer`: the srv layer itself, passed by scripts\coop_srv_mode.script
		                     only: L9 lets a srv script call nothing at load but this function
	print_status()           coop_status: which layers are installed and which one answers
--]]

local api = rawget(_G, "coop") -- engine namespace, nil on an exe without co-op

local type, pairs, ipairs, pcall, tostring, tonumber = type, pairs, ipairs, pcall, tostring, tonumber
local string_format = string.format

local NAMES = { "hostplay", "srv" } -- the order the layers are asked in: the co-op first
local KNOWN = { hostplay = true, srv = true }
local WHERE = { here = true, away = true, joining = true }
local DECIDER = { this = true, other = true, nobody = true }
local ACTIONS = { here = true, pass = true, drop = true }
-- every function a layer has (applies() says whether it answers now)
local FIELDS = { "applies", "where", "decider", "actor_is_player", "decides_world", "leads_here", "is_player_mirror",
	"seat_plays", "group_travels", "from_level", "publish_to", "level_request" }
-- A-S6-IF: functions a layer may have; a layer without one is answered as none answers (a layer table of the tests)
local OPTIONAL = { hook = true, facts_of = true, far = true, writes = true, presence = true, op_done = true }

local function log(fmt, ...)
	local ok, line = pcall(string_format, fmt, ...)
	printf("[coop-mode] %s", ok and line or tostring(fmt))
end

-- a fault of a layer is told three times, then every 100th
local faults = {}
local function fault(what, e)
	local n = (faults[what] or 0) + 1
	faults[what] = n
	if n <= 3 or n % 100 == 0 then log("! %s (#%d): %s", tostring(what), n, tostring(e)) end
end

local function main()
	local m = rawget(_G, "coop_main") or coop_main
	return type(m) == "table" and m or nil
end

-------------------------------------------------------------------------------
-- "none": no session, or no layer installed. Single player is the stock game.
-------------------------------------------------------------------------------
local NONE = {
	name = "none",
	applies = function() return true end,
	where = function() return "away" end,
	decider = function() return "nobody" end,
	actor_is_player = function() return true end,
	decides_world = function() return false end,
	leads_here = function() return false end,
	is_player_mirror = function() return false end,
	seat_plays = function() return false end,
	group_travels = function() return false end,
	from_level = function() return false end,
	publish_to = function() return nil end,
	-- nothing arrives without a session; whatever does is this process's own business
	level_request = function(name, payload, from) return "here", payload, from, false end,
	-- A-S6-IF: no server's script, no body reported from elsewhere, no far view (the stub below)
	hook = function() return nil end,
	facts_of = function() return nil end,
	far = function() return nil end,
	-- R32: single player writes everything; nobody else to count around a place (stock code keeps db.actor); an op's
	-- answer is the module's own business
	writes = function() return true end,
	presence = function() return nil end,
	op_done = function() return false end,
}

-- The far view of the co-op and of single player (F-FAR): every place is this process's, nothing is ordered from afar.
local function core_quests()
	local q = rawget(_G, "coop_quests_core")
	if q == nil then
		local ok, v = pcall(function() return coop_quests_core end)
		q = ok and v or nil
	end
	return type(q) == "table" and q or nil
end

local FAR_STUB = {
	in_scope = function() return nil end, -- no other map is looked at
	level_of_id = function() return nil end,
	order = function() return false end, -- nothing ordered on another map
	fallback = function() return nil end,
	with_level_of = function(peer, fn, ...) return fn(...) end,
	with_target = function(id, peer, what, fn, ...) return fn(...) end,
	at_home = function(fn, ...) return fn(...) end,
	object = function() return nil end,
	note_fail = function() end,
	print_status = function() end,
	-- the Core keeps the handlers (coop_quests_core.add_death_listener) in every process: a server's death relay reads them
	-- whenever its layer comes to answer; the caller registers its stock callback itself
	add_death_listener = function(callback, f)
		local q = core_quests()
		if q and type(q.add_death_listener) == "function" then q.add_death_listener(callback, f) end
	end,
}

-------------------------------------------------------------------------------
-- Layers
-------------------------------------------------------------------------------
local layers = {} -- name -> layer table
local pending = {} -- when_srv functions that have not run yet, in the order they came
local flushing = false

local function valid(layer)
	if type(layer) ~= "table" or not KNOWN[layer.name] then return false, "not a layer (name hostplay or srv)" end
	for _, k in ipairs(FIELDS) do
		if type(layer[k]) ~= "function" then return false, "no function " .. k end
	end
	return true
end

local function run_pending()
	flushing = true
	while pending[1] do
		local fn = table.remove(pending, 1)
		local ok, e = pcall(fn)
		if not ok then fault("when_srv", e) end
	end
	flushing = false
end

-- The layer that answers now: the first installed one whose applies() is true, else "none". The srv layer that
-- answers runs the waiting when_srv functions first.
local function current()
	for _, name in ipairs(NAMES) do
		local layer = layers[name]
		if layer then
			local ok, yes = pcall(layer.applies)
			if not ok then
				fault(name .. ".applies", yes)
			elseif yes == true then
				if name == "srv" and pending[1] and not flushing then run_pending() end
				return layer
			end
		end
	end
	return NONE
end

-- layer.k(...) of the layer that answers; on an error the answer of "none"
local function ask(k, ...)
	local layer = current()
	if OPTIONAL[k] and type(layer[k]) ~= "function" then return NONE[k](...) end
	local ok, a, b, c, d = pcall(layer[k], ...)
	if ok then return a, b, c, d end
	fault(layer.name .. "." .. k, a)
	return NONE[k](...)
end

function install(layer)
	local ok, why = valid(layer)
	if not ok then
		log("! install refused: %s", why)
		return false
	end
	if layers[layer.name] and layers[layer.name] ~= layer then log("the %s layer is replaced", layer.name) end
	layers[layer.name] = layer
	return true
end

function uninstall(name)
	if not KNOWN[name] then return false end
	layers[name] = nil
	return true
end

function when_srv(fn, layer)
	if layer ~= nil then
		if type(layer) == "table" and layer.name == "srv" then install(layer) else log("! when_srv: the layer is not srv") end
	end
	if type(fn) ~= "function" then return false end
	pending[#pending + 1] = fn
	current() -- runs it now when the srv layer answers
	return true
end

-------------------------------------------------------------------------------
-- Questions
-------------------------------------------------------------------------------
local function peer_of(v)
	local n = tonumber(v)
	if type(v) ~= "number" or n ~= n or n < 0 or n % 1 ~= 0 then return nil end
	return n
end

function where(peer)
	peer = peer_of(peer)
	if not peer then return "away" end
	local v = ask("where", peer)
	if WHERE[v] then return v end
	fault("where answer", v)
	return NONE.where(peer)
end

function decider(peer)
	peer = peer_of(peer)
	if not peer then return "nobody" end
	local v = ask("decider", peer)
	if DECIDER[v] then return v end
	fault("decider answer", v)
	return NONE.decider(peer)
end

function actor_is_player() return ask("actor_is_player") == true end
function decides_world() return ask("decides_world") == true end
function leads_here() return ask("leads_here") == true end
function is_player_mirror() return ask("is_player_mirror") == true end
function group_travels() return ask("group_travels") == true end

function seat_plays(peer)
	peer = peer_of(peer)
	return peer ~= nil and ask("seat_plays", peer) == true
end

-- R32 W1: does this process write object `id` (its own numbering)?
function writes(id)
	local n = tonumber(id)
	if type(id) ~= "number" or n ~= n or n < 0 or n >= 65535 or n % 1 ~= 0 then return false end
	return ask("writes", n) == true
end

-- R32 W10: the players around a place ({peer, ...}), nil when there are none to count here (stock code then counts db.actor)
function presence(level, pos)
	local v = ask("presence", level, pos)
	return type(v) == "table" and v or nil
end

-- R32 W7: an op (a table {origin, seq}) that consumes or pays ran with `answer`; true when the layer recorded it
function op_done(op, answer)
	if type(op) ~= "table" then return false end
	return ask("op_done", op, answer) == true
end

function from_level(from)
	from = peer_of(from)
	-- Transport PeerId is uint32_t; 0 is the world seat and 0xffffffff is reserved.
	return from ~= nil and from > 0 and from < 0xffffffff and ask("from_level", from) == true
end

-------------------------------------------------------------------------------
-- A-S6-IF (S6): the answers the S6 groups ask (docs\contracts\coop_mode_api.md section 7)
-------------------------------------------------------------------------------
local function object_id(v)
	return type(v) == "number" and v == v and v > 0 and v < 65535 and v % 1 == 0
end

-- F-BODY: a fresh table of the two facts, each checked; nil when the layer reports nothing
function facts_of(peer)
	peer = peer_of(peer)
	if not peer then return nil end
	local t = ask("facts_of", peer)
	if t == nil then return nil end
	if type(t) ~= "table" then
		fault("facts_of answer", t)
		return nil
	end
	local talking = t.talking
	if talking ~= nil and type(talking) ~= "boolean" then talking = nil end
	local partner = t.partner
	if partner ~= false and not object_id(partner) then partner = nil end
	return { talking = talking, partner = partner }
end

-- F-HOOK
function hook(name)
	if type(name) ~= "string" or name == "" then return nil end
	local f = ask("hook", name)
	if f == nil or type(f) == "function" then return f end
	fault("hook answer", name)
	return nil
end

-- F-FAR: the layer's view, any function it lacks taken from the stub (one wrapper per view)
local far_views = setmetatable({}, { __mode = "k" })
function far()
	local v = ask("far")
	if type(v) ~= "table" then
		if v ~= nil then fault("far answer", v) end
		return FAR_STUB
	end
	local w = far_views[v]
	if not w then
		w = setmetatable({}, { __index = function(_, k)
			local f = v[k]
			if f == nil then return FAR_STUB[k] end
			return f
		end })
		far_views[v] = w
	end
	return w
end

-- F-SHARE: kept by the Core in every process (a map server registers before its layer answers); the server's share carries it
local function share(direction, name, get, set, every)
	if type(name) ~= "string" or name == "" or type(get) ~= "function" or type(set) ~= "function" then return false end
	if every ~= nil and not (type(every) == "number" and every >= 0) then return false end
	local q = core_quests()
	local keep = q and q[direction]
	if type(keep) ~= "function" then return false end
	local ok, e = pcall(keep, name, get, set, every)
	if not ok then
		fault(direction, e)
		return false
	end
	return true
end

function share_up(name, get, set, every) return share("share_up", name, get, set, every) end
function share_down(name, get, set, every) return share("share_down", name, get, set, every) end

-------------------------------------------------------------------------------
-- Delivery
-------------------------------------------------------------------------------
local function send(name, payload, target)
	if not (api and type(api.send_event) == "function") then return false end
	local ok, sent = pcall(api.send_event, name, payload, target)
	return ok and sent == true
end

function publish(verb, t)
	if type(verb) ~= "string" or verb == "" then return false end
	local target = ask("publish_to", verb)
	if type(target) ~= "number" then return false end
	local payload = t
	if type(t) == "table" then
		local m = main()
		if not (m and m.encode) then return false end
		payload = m.encode(t)
	elseif type(t) ~= "string" then
		payload = tostring(t or "")
	end
	return send(verb, payload, target)
end

-- One request: the layer says what to do with it (here / pass / drop), this runs it.
local function request(name, fn, door, payload, from)
	local act, a, b, c = ask("level_request", name, payload, from)
	if not ACTIONS[act] then
		fault("level_request answer", act)
		act, a, b, c = NONE.level_request(name, payload, from)
	end
	if act == "drop" then return end
	if act == "pass" then
		-- to the process that leads his map: a = its peer, b = the request with the player in it
		if door and door(payload, from) ~= true then return end
		if type(a) == "number" and type(b) == "string" then send(name, b, a) end
		return
	end
	-- here: a = the request, b = the player, c = another process passed it on (its door ran there)
	if c ~= true and door and door(a, b) ~= true then return end
	return fn(a, b, c == true)
end

function on_level_request(name, fn, door)
	if type(name) ~= "string" or name == "" or type(fn) ~= "function" then return false end
	if door ~= nil and type(door) ~= "function" then return false end
	local m = main()
	if not (m and m.add_event_handler) then return false end
	return m.add_event_handler(name, function(payload, from)
		return request(name, fn, door, payload, from)
	end)
end

-------------------------------------------------------------------------------
-- Status, game start
-------------------------------------------------------------------------------
function print_status()
	local have = {}
	for _, name in ipairs(NAMES) do
		if layers[name] then have[#have + 1] = name end
	end
	log("layers %s, answers %s, when_srv waiting %d", #have > 0 and table.concat(have, ",") or "-", current().name,
		#pending)
end

-- A player's machine learns the server mode from its first level map (step S3 moves that into Welcome): the waiting
-- when_srv functions run on the first frame the srv layer answers, if no question came before.
local function actor_on_update()
	if pending[1] and not flushing then current() end
end

function on_game_start()
	if not api then return end -- an exe without co-op: no layer ever answers
	RegisterScriptCallback("actor_on_update", actor_on_update)
end
