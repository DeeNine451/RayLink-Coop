--[[
	Anomaly Coop - NPC statistics of the PDA contacts hint (parity audit F4).

	The hint of a contact (ui_pda_contacts_tab) reads what the NPC did from m_data.se_object[id], the Lua state of the
	server object, which the host's game_statistics counts. A client has that table as it was in its join save, and
	nothing else writes it there: a veteran client showed the numbers of the moment he joined.

	The host publishes the hint's six numbers with coop.sync (object scope: it goes when the NPC goes, a joiner gets his copy
	from the engine); a client keeps them in its own m_data, where the hint reads them. Nothing in stock changes.

	A map server counts the NPCs of its level. coop.sync refuses it an object it does not hold as a player, so the numbers go to the world
	server as an event, which keeps them for its save and publishes them.
--]]

local KEY = "npc_stats"
local EV_UP = "npc_stats_up"
local HINT = {
	killed_stalkers = true,
	killed_monsters = true,
	artefacts_found = true,
	wounded_helped = true,
	corpse_looted = true,
	items_sold = true,
}

local installed = false

local function sync() return rawget(_G, "coop") and coop.sync end

local function publish(npc)
	local id = npc and npc:id()
	local se = id and alife_object(id)
	local state = se and alife_storage_manager.get_se_obj_state(se)
	if not state then return end
	local t = {}
	for k in pairs(HINT) do t[k] = state[k] end
	if not coop_mode.decides_world() then
		t.id = id
		coop_mode.publish(EV_UP, t)
	else
		sync().set("object:" .. id, KEY, t)
	end
end

local function bounded_integer(value, lo, hi)
	return value ~= nil and value >= lo and value <= hi and value % 1 == 0
end

local function on_up(payload, from)
	local sender = coop_mode.decides_world() and coop_mode.from_level(from)
	if not coop_trust.pass("npc_stats_sender", sender, "NPC stats from unregistered authority %s", tostring(from))
		or not sender then return end
	local t = coop_main.decode(payload)
	local id = tonumber(t.id)
	local v = {}
	local valid = bounded_integer(id, 1, 0xfffe)
	for k in pairs(HINT) do
		v[k] = tonumber(t[k])
		valid = valid and (t[k] == nil or bounded_integer(v[k], 0, 0x7fffffff))
	end
	if not coop_trust.pass("npc_stats_values", valid, "invalid NPC stats for object %s from %s", tostring(id), tostring(from))
		or not valid then return end
	local se = alife_object(id)
	local state = se and alife_storage_manager.get_se_obj_state(se, true)
	if not state then return end
	for k in pairs(HINT) do state[k] = v[k] end
	sync().set("object:" .. id, KEY, v)
end

local function install_counter()
	local orig = game_statistics and game_statistics.increment_npc_statistic
	if not orig or installed then return end
	installed = true
	game_statistics.increment_npc_statistic = function(npc, value, ...)
		orig(npc, value, ...)
		if HINT[value] and coop.is_active() and (coop_mode.decides_world() or coop_mode.leads_here()) then
			local ok, err = pcall(publish, npc)
			if not ok then printf("! coop_npc_stats: %s", tostring(err)) end
		end
	end
end

local function on_change(_, value, _, _, id)
	if coop_mode.decides_world() then return end
	local se = id and alife_object(id)
	local state = se and value and alife_storage_manager.get_se_obj_state(se, true)
	if not state then return end
	for k in pairs(HINT) do state[k] = value[k] end
end

function on_game_start()
	if not sync() then return end
	coop.sync.on_change("object", KEY, on_change)
	if not coop_mode.is_player_mirror() then install_counter() end
	local cm = rawget(_G, "coop_main") or coop_main
	if cm then cm.add_event_handler(EV_UP, on_up) end
end
