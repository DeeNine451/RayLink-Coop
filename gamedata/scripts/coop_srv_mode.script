-- Сервер (srv): ответы режима «Сервер» для фасада coop_mode (docs/MODES.md, раздел 4)
--[[
	Anomaly Coop - the server mode's answers (gamedata\scripts\coop_srv_mode.script), step S4, layer srv.
	Contract: temp\b58\contracts\coop_mode_api.md; the facade: scripts\coop_mode.script.

	The server: a world server process without a player's map (-coop_dedicated, its actor a ghost on fake_start) and a
	map server per map with players (-coop_mapserver, its actor a ghost too); the players stand on different maps. The
	world server decides the world, the map server of a player's map decides for him there. Processes this layer
	answers in:
	  world server   coop.is_dedicated(): a process started with -coop_dedicated, from its start (step S4, A-S4D): it
	                 loads its world first and starts its session after it (HostAutostart), and its srv scripts register
	                 from when_srv at load, before the stock reads [character_creation] and before the save's load_state.
	                 Before the session the engine gives it no role (is_host false), no seat and no rows: its answers
	                 do not depend on them. Also coop.is_host() in an active session: until step S2 a host whose
	                 session is split into maps (the hybrid: it plays and leads its own map, which today's predicates
	                 give without code of its own)
	  map server     coop.is_map_server(), in an active session
	  player         a player's machine in a split session: it knows from its first level map (step S3 moves that into
	                 Welcome); until then the co-op layer answers for it
	A player's request to the logic of his map: the world server passes it to the map server of his map with his peer
	in it (`_peer`), the map server takes it only from the world server and runs it as his. World data a map server
	changed goes to the world server; the world server's to everybody (the engine adds the bridges).

	Reads today's engine predicates (coop.is_active / is_host / is_map_server / is_dedicated / self_id / players and
	coop.levels.split / bridge_of_player); in step S4 they move to the table srv.* (docs\MODES.md section 4). A srv
	script calls nothing at load but coop_mode.when_srv (check_layers L9): this layer goes to the facade that way.
--]]

local api = rawget(_G, "coop") -- engine namespace, nil on an exe without co-op

local type, pairs, ipairs, pcall, tonumber, tostring = type, pairs, ipairs, pcall, tonumber, tostring

-- f(...) of the engine; nil when it is not there or raises
local function call(f, ...)
	if type(f) ~= "function" then return nil end
	local ok, v = pcall(f, ...)
	if ok then return v end
	return nil
end

local function engine(name) return api ~= nil and call(api[name]) == true end

local function levels()
	local l = api and api.levels
	return type(l) == "table" and l or nil
end

local function map_server() return engine("is_map_server") end
-- -coop_dedicated: the world server without a player, for the whole life of the process (before its session too)
local function dedicated() return engine("is_dedicated") end
local function world_server() return dedicated() or (engine("is_host") and not map_server()) end

local function applies()
	if dedicated() then return true end -- from the process's start: its session comes after its world is up
	if not engine("is_active") then return false end
	if map_server() then return true end
	local l = levels()
	return l ~= nil and call(l.split) == true
end

-- this process's own actor is no player: a map server's and a world server's without a player are ghosts
local function ghost() return map_server() or dedicated() end

local function self_peer()
	local v = api and tonumber(call(api.self_id))
	return v ~= nil and v >= 0 and v or nil
end

-- that peer's row of coop.players() (the seats that play a character), nil when he has none
local function row(peer)
	local list = api and call(api.players)
	if type(list) ~= "table" then return nil end
	for _, p in ipairs(list) do
		if type(p) == "table" and p.id == peer then return p end
	end
	return nil
end

local function leads_here()
	if map_server() then return true end
	return world_server() and not dedicated() -- fake_start: a world server without a player leads no map
end

local function where(peer)
	if peer == self_peer() then
		if ghost() then return "away" end -- no player of this process stands anywhere
		return "here"
	end
	local p = row(peer)
	if not p then return "away" end
	if p.level == nil then return "joining" end -- in the world, not placed on a map yet
	if dedicated() then return "away" end -- the world server has no player's map
	return p.elsewhere == true and "away" or "here"
end

local function decider(peer)
	if peer == self_peer() then
		if ghost() then return "nobody" end
	elseif not row(peer) then
		return "nobody"
	end
	if where(peer) == "here" and leads_here() then return "this" end
	return "other"
end

local function seat_plays(peer)
	if peer == self_peer() and ghost() then return false end
	return row(peer) ~= nil
end

local function from_level(from)
	if not (engine("is_active") and dedicated() and not map_server()) then return false end
	local l = levels()
	local bridges = l and call(l.map_servers)
	if type(bridges) ~= "table" then return false end
	for _, entry in ipairs(bridges) do
		if entry.bridge == from then return true end
	end
	return false
end

local function publish_to()
	if not engine("is_active") then return nil end -- the world server before its session: nobody to send to (as none)
	return map_server() and 0 or -1
end

local function main()
	local m = rawget(_G, "coop_main") or coop_main
	return type(m) == "table" and m or nil
end

local function level_request(name, payload, from)
	if map_server() then
		-- only the world server passes a request on, with the player in it
		local m = main()
		if from ~= 0 or not m then return "drop" end
		local t = m.decode(payload)
		local peer = tonumber(t._peer)
		if not peer then return "drop" end
		t._peer = nil
		return "here", m.encode(t), peer, true
	end
	if world_server() and type(from) == "number" and from ~= 0 then
		local l = levels()
		local bridge = l and tonumber(call(l.bridge_of_player, from))
		local m = main()
		if bridge and m then
			local t = m.decode(payload)
			t._peer = from
			return "pass", bridge, m.encode(t)
		end
	end
	return "here", payload, from, false
end

LAYER = {
	name = "srv",
	applies = applies,
	where = where,
	decider = decider,
	actor_is_player = function() return not ghost() end,
	decides_world = world_server,
	leads_here = leads_here,
	is_player_mirror = function() return not (map_server() or world_server()) end,
	seat_plays = seat_plays,
	group_travels = function() return false end, -- each player walks his own way
	from_level = from_level,
	publish_to = publish_to,
	level_request = level_request,
}

local function started()
	printf("[srv] mode: %s", map_server() and "map server" or world_server() and "world server" or "player")
end

function on_game_start()
	coop_mode.when_srv(started, LAYER)
end
