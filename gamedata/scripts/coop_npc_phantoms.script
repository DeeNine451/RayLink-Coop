--[[
	Anomaly Coop - NPC group (W4 "npc"): phantoms for every player (enemy audit F10, 2026-10-31). Independently derived from
	the original scripts, which stay as they are: no module is reexecuted, no rule of theirs is replaced.

	Native hooks (host, with clients; otherwise every wrapped function is the original):
	  - phantom_manager: a monster spawns dynamic phantoms while it fights "the actor" within 30 m of db.actor, the host.
	    Its private handler now also runs as the client the monster fights, so the timer, the checks and the limit stand.
	    The engine sends the phantom at the nearest player (CPhantom::net_Spawn, every machine's copy at the same one).
	  - xcv_phantoms (G.A.M.M.A.): coop_route runs its actor_on_update as each player in turn. arszi_psy.get_ppe_intensity
	    now answers for that player (what his machine reports, coop_economy_mdata), not with the host's psy health. A
	    phantom's contact is measured to the nearest player; the psy hit lands on him in the phantom's name, because a hit
	    a character deals itself never reaches its owner (hits::to_owner).
	Left: xcv's squad still runs to "actor". sim_squad_scripted resolves that to id 0, and a player's character has none of
	a squad target's methods (am_i_reached, on_reach_target, get_alife_task). Next to the host it changes nothing; near a
	far client a phantom heads off to the host.
--]]

local type, ipairs, pcall, error = type, ipairs, pcall, error
local installed = false

-- The client a monster is fighting now, nil for anybody else.
local function fought_client(P, npc)
	local enemy = npc and npc:alive() and npc:get_enemy()
	return enemy and P.is_proxy(enemy) and enemy or nil
end

local function dynamic(C, P, active)
	local m = C.mod("phantom_manager")
	if not m then return false end
	local old, holder, index = C.find_local(m, "monster_on_update")
	if type(old) ~= "function" or not holder then return false end
	local wrapped = function(npc, st, ...)
		-- The route declares this wrapper host-only. A direct invocation on a client must not spawn either.
		if P.is_client() then return end
		local player = active() and not P.in_identity() and fought_client(P, npc)
		if not player then return old(npc, st, ...) end
		-- Stock asks this table, which knows fights with the host only: marked for this one call.
		local fights = xr_combat_ignore.fighting_with_actor_npcs
		local id = npc:id()
		local had = fights[id]
		fights[id] = true
		local ok, err = pcall(P.with_identity, player, old, npc, st, ...)
		fights[id] = had
		if not ok then error(err, 0) end
	end
	debug.setupvalue(holder, index, wrapped)
	C.swap_callback("monster_on_update", old, wrapped)
	return true
end

local function psy(C, P, active)
	local m, reports = C.mod("arszi_psy"), C.mod("coop_economy_mdata")
	local get = m and m.get_ppe_intensity
	if type(get) ~= "function" or not reports then return false end
	local _, holder, index = C.find_local(m, "psy_table")
	if not holder then return false end
	m.get_ppe_intensity = function(...)
		local who = active() and P.in_identity() and db.actor
		if not (who and P.is_proxy(who)) then return get(...) end
		local _, t = debug.getupvalue(holder, index) -- arszi replaces the table at load_state
		if type(t) ~= "table" then return get(...) end
		local report = reports.player_value(who:id(), "psy_table")
		local saved = t.actor_psy_health
		t.actor_psy_health = type(report) == "table" and report.actor_psy_health or 1 -- nothing reported yet: healthy
		local ok, value = pcall(get, ...)
		t.actor_psy_health = saved
		if not ok then error(value, 0) end
		return value
	end
	return true
end

local function contact(C, P, active)
	local m = C.mod("xcv_phantoms")
	local update, psi_hit = m and m.monster_on_update, m and m.psi_health_hit
	if type(update) ~= "function" or type(psi_hit) ~= "function" then return false end
	local _, holder, index = C.find_local(m, "spawned_phantoms")
	local power = C.find_local(m, "psi_hit_power")
	if not holder or type(power) ~= "number" then return false end
	local phantom -- the one touching a client, while xcv's update runs as him
	m.psi_health_hit = function(enable, ...)
		if not (phantom and enable) then return psi_hit(enable, ...) end
		local h = hit()
		h.power = math.random(power * 10 - 20, power * 10 + 10) / 1000
		h.bone = "bip01_spine"
		h.impulse = 0
		h.direction = vector()
		h.draftsman = phantom
		h.type = hit.telepatic
		db.actor:hit(h)
	end
	local wrapped = function(npc, ...)
		if P.is_client() then return end
		local squad = active() and not P.in_identity() and npc and npc:alive() and get_object_squad(npc)
		local _, spawned = debug.getupvalue(holder, index) -- xcv replaces the table at load_state
		local near = squad and type(spawned) == "table" and spawned[squad.id] and P.nearest(npc)
		if not (near and P.is_proxy(near)) then return update(npc, ...) end
		phantom = npc
		local ok, err = pcall(P.with_identity, near, update, npc, ...)
		phantom = nil
		if not ok then error(err, 0) end
	end
	m.monster_on_update = wrapped
	C.swap_callback("monster_on_update", update, wrapped)
	return true
end

function install(P, active, applied)
	if installed then return end
	local C = coop_mods_core
	if not (C and type(C.find_local) == "function") then return end
	installed = true
	for _, spec in ipairs({ { "phantoms", dynamic }, { "phantom_psy", psy }, { "phantom_contact", contact } }) do
		local ok, result = pcall(spec[2], C, P, active)
		if not ok then
			P.report("compat", "native " .. spec[1], result)
		elseif result then
			applied[#applied + 1] = "native:" .. spec[1]
		end
	end
end
