--[[
	Anomaly Coop - split levels: one brain of the world (docs\SPLIT_LEVELS.md, plan T15).

	The world server alone decides where squads go, also those a map server holds online. Once a second it picks the
	targets of a few of them with the stock board (their ALife records are the world's) and tells that map server; there
	the stock squad update asks the board and gets that answer. A squad nobody decided for yet stays at its smart.

	The logic of an NPC (m_data.game_object[id], what xr_logic reads when it comes online) travels with the object, and so does
	what a squad's stock update keeps in Lua: its smart, its target, how long it stays. The engine asks logic_of when it hands an
	object over and logic_in when it takes one (coop_levels_alife.cpp): both sides of a transfer know where the squad was going,
	whichever side ran it last. Who updates a squad: the world server while it is offline at home, on a map server the binder of
	its commander while it is online, the engine (coop_levels_xfer.cpp xfer_scheduled) while it is held and offline.

	treasure_manager.caches says which box holds a stash, and each process has a copy from its save. A box is opened on the authority of its
	level, the marks and the save are the world server's: every few seconds each side tells the other what changed, the world server
	each map server what concerns its level (all of it the first time: that save may be older).

	API:
		coop_levels_brain.logic_of(id)   the engine: coop.levels.logic_put(bytes of this object's logic)
		coop_levels_brain.logic_in(id)   the engine: coop.levels.logic_bytes() is the logic of this object
		coop_levels_brain.left(id)       the engine on a map server: this object went home
		coop_levels_brain.caches_now()   the caches are looked at on the next update: a box was just filled
--]]

local api = rawget(_G, "coop")

local EV_TARGETS = "coop_brain"
local EV_CACHES = "coop_caches"
local TICK_MS = 1000
local CACHES_MS = 3000 -- treasure_manager.caches are compared this often
local CACHE_BYTES = 12000 -- in one event
local AGAIN_MS = 30000 -- a squad's target is looked at this often
local ROWS_A_TICK = 8 -- get_squad_target walks the whole board

local targets = {} -- map server: squad id -> the target the world gave it
local decided = {} -- world server: squad id -> when its target is due again
local next_tick = 0
local cache_next = 0
local known_up = nil -- map server: stash box -> what the world server has of it
local told = {} -- world server: bridge -> stash box -> what that map server has of it
local box_level = {} -- world server: stash box -> its level, false: no such object

local function levels()
	return api and api.levels
end

local function split()
	local l = levels()
	return l ~= nil and l.split ~= nil and l.split() == true
end

local function map_server()
	return api ~= nil and api.is_map_server ~= nil and api.is_map_server() == true
end

local function world_server()
	return api ~= nil and api.is_host() == true
end

-- World server: the targets of the squads map server `ms` holds.
local function tell(ms, now)
	local l = levels()
	local rows = {}
	for _, id in ipairs(l.squads_at(ms.bridge)) do
		if #rows >= ROWS_A_TICK then break end
		if now >= (decided[id] or 0) then
			local squad = alife_object(id)
			local ok, target = pcall(SIMBOARD.get_squad_target, SIMBOARD, squad)
			if squad and ok and target then
				decided[id] = now + AGAIN_MS
				rows[#rows + 1] = id .. ":" .. target.id
			end
		end
	end
	if #rows > 0 then api.send_event(EV_TARGETS, table.concat(rows, ","), ms.bridge) end
end

local function the_caches()
	local tm = rawget(_G, "treasure_manager") or treasure_manager
	return tm and type(tm.caches) == "table" and tm.caches or nil
end

local function cache_row(id, v)
	if v == nil then return id .. "|n|" end
	if v == true then return id .. "|t|" end
	if v == false then return id .. "|f|" end
	return id .. "|s|" .. tostring(v)
end

-- What differs from `known` goes into a batch and into `known`. -> the batch, true when more is left for the next one.
local function cache_diff(c, known, wanted)
	local rows, bytes = {}, 0
	local function add(id, v)
		local r = cache_row(id, v)
		rows[#rows + 1] = r
		bytes = bytes + #r + 1
		known[id] = v
		return bytes >= CACHE_BYTES
	end
	for id, v in pairs(c) do
		if known[id] ~= v and (wanted == nil or wanted(id)) and add(id, v) then return rows, true end
	end
	for id in pairs(known) do
		if c[id] == nil and add(id, nil) then return rows, true end
	end
	return rows, false
end

local function on_level(id, lid)
	local l = box_level[id]
	if l == nil then
		local se = alife_object(id)
		l = se and game_graph():vertex(se.m_game_vertex_id):level_id() or false
		box_level[id] = l
	end
	return l == lid
end

local function caches_of_world(c)
	local live, more = {}, false
	for _, ms in ipairs(levels().map_servers()) do
		live[ms.bridge] = true
		told[ms.bridge] = told[ms.bridge] or {}
		local rows, left = cache_diff(c, told[ms.bridge], function(id) return on_level(id, ms.level) end)
		if #rows > 0 then api.send_event(EV_CACHES, table.concat(rows, ";"), ms.bridge) end
		more = more or left
	end
	for bridge in pairs(told) do
		if not live[bridge] then told[bridge] = nil end -- the next process on that bridge starts from a newer save
	end
	return more
end

local function baseline(c)
	if known_up then return end
	known_up = {}
	for id, v in pairs(c) do known_up[id] = v end
end

local function caches_of_map(c)
	if not known_up then return baseline(c) end
	local rows, left = cache_diff(c, known_up)
	if #rows > 0 then api.send_event(EV_CACHES, table.concat(rows, ";"), 0) end
	return left
end

local function caches_tick(now)
	cache_next = now + CACHES_MS
	local c = the_caches()
	local go = world_server() and caches_of_world or map_server() and caches_of_map or nil
	if not (c and go and split()) then return end
	local ok, more = pcall(go, c)
	if not ok then
		printf("[coop-brain] ! caches: %s", tostring(more))
	elseif more then
		cache_next = 0
	end
end

local function on_caches(payload, from)
	local c = the_caches()
	if not c then return end
	local known
	if map_server() then
		if from ~= 0 then return end
		baseline(c)
		known = known_up
	elseif world_server() and split() then
		for _, ms in ipairs(levels().map_servers()) do
			if ms.bridge == from then
				told[from] = told[from] or {}
				known = told[from]
			end
		end
	end
	if not known then return end
	for id, kind, text in payload:gmatch("(%d+)|(%a)|([^;]*)") do
		local v = nil
		if kind == "t" then v = true elseif kind == "f" then v = false elseif kind == "s" then v = text end
		id = tonumber(id)
		c[id] = v
		known[id] = v
	end
end

function caches_now() cache_next = 0 end

local function on_update()
	local now = time_global()
	if now >= cache_next then caches_tick(now) end
	if now < next_tick then return end
	next_tick = now + TICK_MS
	if not (world_server() and split() and SIMBOARD) then return end
	for _, ms in ipairs(levels().map_servers()) do
		local ok, err = pcall(tell, ms, now)
		if not ok then printf("[coop-brain] ! %s", tostring(err)) end
	end
end

local function on_targets(payload, from)
	if not map_server() or from ~= 0 then return end
	for squad, target in payload:gmatch("(%d+):(%d+)") do
		targets[tonumber(squad)] = tonumber(target)
	end
end

-- The stock squad update asks the board; on a map server the board is the world server's.
local function patch_board()
	local cls = sim_board and sim_board.simulation_board
	if not cls then return end
	local orig = cls.get_squad_target
	cls.get_squad_target = function(self, squad)
		if not map_server() then return orig(self, squad) end
		local id = targets[squad.id]
		return (id and alife_object(id)) or (squad.smart_id and alife_object(squad.smart_id)) or squad
	end
end

local function squad_at(id)
	local se = alife_object(id)
	return se and se.clsid and se:clsid() == clsid.online_offline_group_s and se or nil
end

-- What sim_squad_scripted keeps between updates and no packet carries while it lives.
local function mind_of(se)
	return {
		smart = se.smart_id, target = se.assigned_target_id, current = se.current_target_id, action = se.current_action,
		task = se.task_target_id, script = se.scripted_target, idle = se.idle_time, lock = se.__lock or nil,
		rush = se.rush_to_target, spawn = se.respawn_point_id, prop = se.respawn_point_prop_section,
		stay = se.stay_time and utils_data.CTime_to_table(se.stay_time) or nil,
	}
end

local function mind_in(se, t)
	if se.smart_id ~= t.smart then SIMBOARD:assign_squad_to_smart(se, t.smart) end
	se.assigned_target_id, se.current_target_id, se.current_action = t.target, t.current, t.action
	se.task_target_id, se.scripted_target, se.idle_time = t.task, t.script, t.idle or se.idle_time
	se.__lock, se.rush_to_target = t.lock, t.rush
	se.respawn_point_id, se.respawn_point_prop_section = t.spawn, t.prop
	se.stay_time = t.stay and utils_data.CTime_from_table(t.stay) or nil
	se.first_update = true -- the side it came from did what is done once: the items of item_on_all exist
end

function logic_of(id)
	local squad = squad_at(id)
	local t = squad and mind_of(squad) or alife_storage_manager.get_state().game_object[id]
	local ok, bytes = pcall(marshal.encode, t)
	levels().logic_put(t and ok and bytes or "")
end

function logic_in(id)
	local ok, t = pcall(marshal.decode, levels().logic_bytes())
	if not (ok and type(t) == "table") then return end
	local squad = squad_at(id)
	if squad then
		mind_in(squad, t)
	else
		alife_storage_manager.get_state().game_object[id] = t
	end
end

-- Map server: a squad went home. It keeps no job on this level's smarts; if it comes back, its mind comes with it.
function left(id)
	local squad = squad_at(id)
	if squad and squad.smart_id and SIMBOARD then SIMBOARD:assign_squad_to_smart(squad, nil) end
end

function _targets() return targets end
function _tick() next_tick = 0; on_update() end

function on_game_start()
	if not api then return end
	patch_board()
	coop_main.add_event_handler(EV_TARGETS, on_targets)
	coop_main.add_event_handler(EV_CACHES, on_caches)
	RegisterScriptCallback("actor_on_update", on_update)
end
