--[[
	Anomaly Coop - travelling as a group (gamedata\scripts\coop_economy_travel.script)
	SPEC R-4.4 (scripted teleports act on the group), R-9.4 (fast travel and guides move the group).

	Who travels and what happens to the others:
	  - Fast travel and backpack travel (PDA map menu), marsh guides (dialogs_mlr *_guid): with the party rule
	    on (core rule party_fast_travel) the traveller moves as in single player and pays his fare alone, and
	    every other player on the map is OFFERED the trip (a yes / no window, "economy.tp" with q): who says yes
	    is moved to the destination for nothing, who says no or does not answer within the vote's time stays
	    (owner 2026-11-16; before that a trip was refused until the group stood within gather_radius, and who
	    stood there was moved unasked). Fair Fast Travel's rows count as well: fast travel, backpack travel and a
	    hired guide. With split levels (coop.levels.split) every player walks his own map: one player travels and
	    nobody is asked.
	  - Time: a trip takes no game time in a session (owner 2026-11-16, "time must not run ahead on a travel, let only
	    the move work, and hunger and the rest with it"): coop_economy_group drops the trip's level.change_game_time,
	    and Fair Fast Travel is told before a trip that it is one without time (on_before_fast_travel, trip.notime: it
	    then moves no clock, pauses no hunger, tells no surge that time ran and forces no weather). The fare, the
	    cooldown and the wear of the gear are the mod's own and stay. With the world's rule travel_takes_time on, the
	    time cost of a group travel is applied once, by the host; a solo travel never moves the shared clock.
	  - Companions: the squads the traveller leads come with him, as in single player (Fair Fast Travel: "unless you asked
	    them to wait"): after his own trip on his map and after his yes to another's, coop_npc_companions.bring_mine asks the
	    authority of his level to move them. A story teleport brings nobody, as the stock.
	  - Travel to another level (fast travel to an offline point, guides of ka_travel): the engine turns a
	    client's level change into a request to the host, the host moves the whole group (coop_join), so only
	    the time cost is handled here. A quick pin of a client's own map is no level: Fair Fast Travel takes it for one, what he creates
	    never goes online on his copy of the world, and with_trip_on_map makes the trip a move on his map.
	  - xr_effects.teleport_actor (story teleports): the players within teleport_radius of the teleported
	    player follow to the same point and heading. A replicated restrictor's teleport is left to the NPC
	    group (coop_npc_logic sends it to the restrictor's audience); this covers the rest (NPC logic on the
	    host, scripts, and every machine when coop_npc_logic is absent).
	  - Guide routes (txr_routes.open_route): a route opened on any machine is opened on every machine.
	Outside a session every wrapper calls the stock function unchanged.

	For other scripts:
		coop_economy_travel.group_teleport(dest, heading, origin, radius, kind)  this player moved from origin
		    to dest; the players around origin follow (dest/origin: vectors or {x,y,z}; heading nil = keep)

	Visited places (a client): smart_terrain.script tells actor_on_interaction("smarts", smart, name) while the actor is
	within 50 m of an online smart; game_statistics (the places visited) and Fair Fast Travel (state 1: only the points
	visited) listen. A client's ALife is frozen, its smarts never update, so he visited nothing and had no points. The
	client counts it here: once a second, the fast travel points of his map (game_fast_travel.tsmarts) within 50 m.

	Events:
		economy.tp     mover -> host -> others   { x, y, z, h (optional), ox, oy, oz, r, l = level, k = kind, n = nick,
		                                           q = 1: an offer (every player of the level is asked; r is 0) }
		economy.route  any -> host -> others     { a, b }  (txr_routes short level names)
--]]

local core = coop_economy_core
local group = coop_economy_group

local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall

local MOVE_EPS = 2.0 -- m: a travel that moved the actor less than this is not a travel
local WATCH_MS = 1500 -- a move done a bit later (delayed teleports) is still caught
local WATCH_JUMP = 25.0 -- m: a later move must be at least this long (walking is not a travel)
local MAX_RADIUS = 200
local ARRIVE_EPS = 3.0 -- m: a player already this close to the destination stays put
local SPREAD = 1.0 -- m: arrivals are spread a little so the group does not stack
local OFFER = -1 -- in place of a radius: no radius, every other player of the level is asked whether he comes along

local installed = false
local watch = nil -- { kind, radius, heading, o = origin, l = level, until_ms }
local applying_route = false
local stats = { sent = 0, applied = 0, skipped = 0, relayed = 0, vetoed = 0, routes_out = 0, routes_in = 0, offered = 0,
	accepted = 0, declined = 0 }
local asked = nil -- this player: the open offer { box, until_ms }

local function vec_of(v)
	if not v then return nil end
	return { x = tonumber(v.x), y = tonumber(v.y), z = tonumber(v.z) }
end

local function level_name()
	local ok, n = pcall(level.name)
	return ok and n or ""
end

-------------------------------------------------------------------------------
-- Group teleport
-------------------------------------------------------------------------------
local function make_payload(dest, heading, origin, radius, kind)
	local offer = radius == OFFER
	local t = { x = dest.x, y = dest.y, z = dest.z, ox = origin.x, oy = origin.y, oz = origin.z,
		r = offer and 0 or math.min(radius or 0, MAX_RADIUS), l = level_name(), k = kind or "travel", n = core.nick_of(core.self_id()) }
	if heading then t.h = heading end
	if offer then t.q = 1 end
	return t
end

-- Validated teleport from the wire, or nil.
local function read_tp(t)
	local p = {
		x = core.num(t.x, -1e5, 1e5), y = core.num(t.y, -1e5, 1e5), z = core.num(t.z, -1e5, 1e5),
		ox = core.num(t.ox, -1e5, 1e5), oy = core.num(t.oy, -1e5, 1e5), oz = core.num(t.oz, -1e5, 1e5),
		r = core.num(t.r, 0, MAX_RADIUS), h = t.h ~= nil and core.num(t.h, -100, 100) or nil,
		l = type(t.l) == "string" and t.l or nil, k = core.word(t.k, 16) or "travel",
		q = t.q == 1 or t.q == true,
	}
	if not (p.x and p.y and p.z and p.ox and p.oy and p.oz and p.r and p.l) then return nil end
	if t.h ~= nil and not p.h then return nil end
	return p
end

-- The companions of this machine's player come after him (the authority of his level moves them; nothing without that script).
local function bring_companions()
	local nc = core.mod("coop_npc_companions")
	if not (nc and type(nc.bring_mine) == "function") then return end
	local ok, err = pcall(nc.bring_mine)
	if not ok then core.log("! the companions were not called after the trip: %s", tostring(err)) end
end

-- This machine's actor follows when it stood within the radius of the origin on the same level; `agreed`: he said yes to an
-- offer, wherever he stands on that level.
local function apply_tp(p, by, agreed)
	local actor = db.actor
	if not actor or p.l ~= level_name() then return false end
	local mine = core.position_of_id(0)
	if not mine then return false end
	local dest = { x = p.x, y = p.y, z = p.z }
	if (not agreed and core.dist(mine, { x = p.ox, y = p.oy, z = p.oz }) > p.r) or core.dist(mine, dest) <= ARRIVE_EPS then
		stats.skipped = stats.skipped + 1
		return false
	end
	local v = vector():set(p.x + (math.random() - 0.5) * SPREAD, p.y, p.z + (math.random() - 0.5) * SPREAD)
	actor:set_actor_position(v)
	if p.h then actor:set_actor_direction(p.h) end
	pcall(level.add_pp_effector, "sleep_fade.ppe", 5528, false)
	stats.applied = stats.applied + 1
	core.log("followed %s (%s) to %.1f %.1f %.1f", tostring(by), p.k, p.x, p.y, p.z)
	if agreed then bring_companions() end -- his yes to a trip is a trip of his own
	return true
end

local function close_offer()
	local a = asked
	asked = nil
	if a and a.box then pcall(function() a.box.message_box:HideDialog() end) end
end

-- A trip of another player of this level: this player is asked whether he comes along (a yes / no window; the traveller has
-- paid, it costs this player nothing). Yes moves him to the destination; no, or no answer within the vote's time, leaves him.
-- A dead or downed player, one who stands at the destination already, and a machine whose actor is nobody are not asked.
local function offer_tp(p, by)
	local actor = db.actor
	if not actor or p.l ~= level_name() then return false end
	local alive_ok, alive = pcall(function() return actor:alive() end)
	if alive_ok and alive == false then return false end
	local mine = core.position_of_id(0)
	if not mine then return false end
	local away = core.dist(mine, { x = p.x, y = p.y, z = p.z })
	if away <= ARRIVE_EPS then return false end
	close_offer()
	local id = p.k == "guide" and "st_coop_eco_guide_offer" or "st_coop_eco_travel_offer"
	local fallback = p.k == "guide" and "%s goes with a guide, %d m from you. Go with him? It costs you nothing."
		or "%s fast travels, %d m from you. Go with him? It costs you nothing."
	local text = core.fmt(id, fallback, tostring(by or "?"), math.floor(away + 0.5))
	local mine_now = { until_ms = core.now() + (core.rule("vote_timeout") or 30) * 1000 }
	-- ui_dyn_msg_box.msg_box_ui is a luabind class: calling it makes the window
	local box = rawget(_G, "ui_dyn_msg_box") or core.mod("ui_dyn_msg_box")
	local class = box and box.msg_box_ui
	if class == nil then
		core.log("! ui_dyn_msg_box.msg_box_ui is not here: the trip of %s is not offered", tostring(by))
		return false
	end
	local ok, b = pcall(class, "message_box_yes_no", true, text, function()
		if asked ~= mine_now then return end -- the offer closed meanwhile
		asked = nil
		stats.accepted = stats.accepted + 1
		apply_tp(p, by, true)
	end, function()
		if asked ~= mine_now then return end
		asked = nil
		stats.declined = stats.declined + 1
	end)
	if not ok then
		core.log("! the trip of %s could not be offered: %s", tostring(by), tostring(b))
		return false
	end
	mine_now.box = b
	asked = mine_now
	stats.offered = stats.offered + 1
	core.tip(text, 8000)
	return true
end

-- radius OFFER: no radius, every other player of the level is asked (a trip); else the players within `radius` of the origin
-- follow unasked (a story teleport).
function group_teleport(dest, heading, origin, radius, kind)
	dest, origin = vec_of(dest), vec_of(origin)
	if not (core.live() and dest and origin and dest.x and origin.x) or core.others_count() == 0 then return false end
	if radius ~= OFFER and (radius or 0) <= 0 then return false end
	local t = make_payload(dest, heading, origin, radius, kind)
	stats.sent = stats.sent + 1
	if core.is_host() then
		core.send_clients("tp", t)
	else
		core.send("tp", t, 0)
	end
	return true
end

-- Host: a client moved; follow if close, and tell the other clients.
local function host_on_tp(t, from)
	local p = read_tp(t)
	local pl = p and core.player(from)
	if not pl then return end
	-- the sender stands at one end of that move (its character here may lag a snapshot): a made-up origin
	-- at the host's feet would move the host (W5)
	local at = pl.avatar_id and core.position_of_id(pl.avatar_id)
	if not (at and (core.dist(at, { x = p.ox, y = p.oy, z = p.oz }) <= 30 or core.dist(at, p) <= 30)) then
		stats.refused = (stats.refused or 0) + 1
		return
	end
	t.n = core.nick_of(from)
	if p.q then offer_tp(p, t.n) else apply_tp(p, t.n) end
	stats.relayed = stats.relayed + core.send_clients("tp", t, from)
end

-- The local actor went from w.o to `dest` by a trip: his companions come after him (not after a story teleport), and the others
-- are told (group_teleport does nothing for a trip of one: radius 0).
local function moved(w, dest)
	if w.kind ~= "story" then bring_companions() end
	group_teleport(dest, w.heading, w.o, w.radius, w.kind)
end

-- Check whether the local actor moved since `origin`: then the trip happened.
local function moved_check(w, threshold)
	if not db.actor or w.l ~= level_name() then return true end -- level change: the host moves the group
	local now_pos = core.position_of_id(0)
	if now_pos and core.dist(now_pos, w.o) >= threshold then
		moved(w, now_pos)
		return true
	end
	return false
end

local function pack_n(...) return { n = select("#", ...), ... } end

-- Runs fn(...) (a travel of this player); afterwards the players around the start follow.
-- dest: where fn puts the actor when the caller knows it (else the actor's position after the call).
local function travel_call(kind, radius, heading, arm_time, dest, fn, ...)
	local w = { kind = kind, radius = radius, heading = heading, o = core.position_of_id(0), l = level_name() }
	local res
	if arm_time then
		res = pack_n(group.with_arm("travel", fn, ...))
	else
		res = pack_n(fn(...))
	end
	if w.o then
		if dest and w.l == level_name() then
			if core.dist(dest, w.o) >= MOVE_EPS then moved(w, dest) end
		elseif not moved_check(w, MOVE_EPS) then
			w.until_ms = core.now() + WATCH_MS
			watch = w
		end
	end
	return unpack(res, 1, res.n)
end

-------------------------------------------------------------------------------
-- Stock patches
-------------------------------------------------------------------------------
-- The words Fair Fast Travel (game_fast_travel.parse_trip_tokens) puts in front of the destination of a row: fast
-- travel, backpack travel and a hired guide. "\1" is no text of a language: an id without a string recognises nothing.
local TRAVEL_ROWS = { "st_pda_fast_travel_to", "st_pda_backpack_travel_to", "st_fftd_mapspot_guideto" }

-- "travel" | "guide" (a guide hired through the map menu) for a row that is a trip, nil for any other row.
local function travel_kind(prop)
	if type(prop) ~= "string" or prop == "" then return nil end
	if prop == core.tr("bp_to", "\1") then return "travel" end
	for _, id in ipairs(TRAVEL_ROWS) do
		local prefix = core.tr(id, "\1") .. " "
		if prop:sub(1, #prefix) == prefix then return id == "st_fftd_mapspot_guideto" and "guide" or "travel" end
	end
	return nil
end

-- The text of the row picked in the map's property menu (nil: none, or the menu is gone).
local function selected_prop(property_ui)
	local ok, text = pcall(function()
		local row = property_ui:GetSelectedItem()
		if row == nil then return nil end
		return row:GetTextItem():GetText()
	end)
	if ok then return text end
	return nil
end

-- The smart is on the map the actor is on (a client's ALife copy holds the smarts of every map).
local function on_this_map(se, here)
	local ok, name = pcall(function()
		return alife():level_name(game_graph():vertex(se.m_game_vertex_id):level_id())
	end)
	return ok and name == here
end

-- A client's ALife never brings what he creates online: Fair Fast Travel takes a quick pin of his own map for a point of another one and
-- ends the trip in ChangeLevel, after the fare and the time. The engine has no level changer for that: with one level there is no trip,
-- with split levels a whole rejoin. While the click runs, a level change to his own map is what the stock does for an online point.
local function with_trip_on_map(f, ...)
	local change = rawget(_G, "ChangeLevel")
	if not (core.is_client() and type(change) == "function") then return f(...) end
	_G.ChangeLevel = function(pos, lvid, gvid, dir, anim)
		if on_this_map({ m_game_vertex_id = gvid }, level_name()) then return db.actor:set_actor_position(pos) end
		return change(pos, lvid, gvid, dir, anim)
	end
	local res = pack_n(pcall(f, ...))
	_G.ChangeLevel = change
	if not res[1] then error(res[2], 0) end
	return unpack(res, 2, res.n)
end

local function patch_pda()
	local pda = core.mod("pda")
	if not (pda and type(pda.property_box_clicked) == "function") then
		core.log("! pda.property_box_clicked missing: fast travel is not a group travel")
		return
	end
	local orig = pda.property_box_clicked
	pda.property_box_clicked = function(property_ui, ...)
		local kind = core.live() and db.actor and core.others_count() > 0 and travel_kind(selected_prop(property_ui))
		if not kind then return orig(property_ui, ...) end
		-- a shared map: he goes, the others are asked; split levels or the rule off: he goes alone
		return travel_call(kind, group.travel_as_group() and OFFER or 0, nil, true, nil, with_trip_on_map, orig, property_ui, ...)
	end
end

-- In-level guides of the stock game (dialog actions that move the actor).
local GUIDES = {
	dialogs_mlr = { "marsh_post_guid", "marsh_pump_water_guid", "marsh_old_church_guid", "marsh_tech_yard_guid" },
}

local function patch_guides()
	for modname, list in pairs(GUIDES) do
		local m = core.mod(modname)
		for _, fname in ipairs(list) do
			local orig = m and m[fname]
			if type(orig) == "function" then
				m[fname] = function(...)
					if not (core.live() and db.actor) or core.others_count() == 0 then return orig(...) end
					return travel_call("guide", group.travel_as_group() and OFFER or 0, nil, true, nil, orig, ...)
				end
			end
		end
	end
	-- Guides to other levels (ka_travel): the level change is the host's; only the time cost is routed.
	local ka = core.mod("ka_travel")
	if ka then
		local names = {}
		for k, v in pairs(ka) do
			if type(v) == "function" and type(k) == "string" and k:find("^travel_to_") then names[#names + 1] = k end
		end
		for _, k in ipairs(names) do
			local orig = ka[k]
			ka[k] = function(...)
				if not core.live() then return orig(...) end
				return group.with_arm("travel", orig, ...)
			end
		end
	end
end

-- True when the NPC group's restrictor logic (coop_npc_logic) already sends this teleport to its audience:
-- the effect of a replicated restrictor on the host, and every relayed run on a client.
local function routed_by_npc_group(npc)
	local nl = rawget(_G, "coop_npc_logic")
	if not (nl and type(nl.deliver) == "function") then return false end
	if core.is_client() then return true end
	local ok, r = pcall(function() return npc ~= nil and nl.is_replicated(npc:id()) == true end)
	return ok and r == true
end

local function patch_teleport_actor()
	local xe = core.mod("xr_effects")
	if not (xe and type(xe.teleport_actor) == "function") then
		core.log("! xr_effects.teleport_actor missing: story teleports move one player")
		return
	end
	local orig = xe.teleport_actor
	xe.teleport_actor = function(actor, npc, p, ...)
		if not (core.live() and db.actor and type(p) == "table" and p[1]) or core.others_count() == 0
			or routed_by_npc_group(npc) then
			return orig(actor, npc, p, ...)
		end
		local heading, dest = nil, nil
		local ok, d = pcall(function() return vec_of(patrol(p[1]):point(0)) end)
		if ok and d and d.x then dest = d end
		if p[2] ~= nil then
			local okh, h = pcall(function()
				return -patrol(p[2]):point(0):sub(patrol(p[1]):point(0)):getH()
			end)
			if okh and type(h) == "number" then heading = h end
		end
		return travel_call("story", core.rule("teleport_radius") or 50, heading, false, dest, orig, actor, npc, p, ...)
	end
end

local orig_open_route = nil

-- Opens a route here without announcing it again (silent, as the stock bulk opening does).
local function open_route_local(a, b)
	if not orig_open_route then return false end
	applying_route = true
	local ok, err = pcall(orig_open_route, a, b, true)
	applying_route = false
	if not ok then core.log("! route %s-%s: %s", a, b, tostring(err)) end
	return ok
end

local function patch_routes()
	local tr = core.mod("txr_routes")
	if not (tr and type(tr.open_route) == "function") then return end
	local orig = tr.open_route
	orig_open_route = orig
	tr.open_route = function(m1, m2, no_msg, ...)
		local r = orig(m1, m2, no_msg, ...)
		if not applying_route and core.live() and type(m1) == "string" and type(m2) == "string" and core.others_count() > 0 then
			stats.routes_out = stats.routes_out + 1
			if core.is_host() then
				core.send_clients("route", { a = m1, b = m2 })
			else
				core.send("route", { a = m1, b = m2 }, 0)
			end
		end
		return r
	end
end

local function install()
	if installed then return end
	installed = true
	patch_pda()
	patch_guides()
	patch_teleport_actor()
	patch_routes()
end

-------------------------------------------------------------------------------
-- Events
-------------------------------------------------------------------------------
local function on_route(t, from)
	local a, b = core.word(t.a, 32), core.word(t.b, 32)
	if not (a and b and orig_open_route) then return end
	if core.is_host() then
		if from <= 0 then return end
		open_route_local(a, b)
		core.send_clients("route", { a = a, b = b }, from)
	elseif from == 0 then
		open_route_local(a, b)
	else
		return
	end
	stats.routes_in = stats.routes_in + 1
end

local function register_events()
	core.on("tp", function(t, from)
		if core.is_host() then
			if from > 0 then host_on_tp(t, from) end
		elseif from == 0 then
			local p = read_tp(t)
			if p and p.q then
				offer_tp(p, t.n)
			elseif p then
				apply_tp(p, t.n)
			end
		end
	end)
	core.on("route", on_route)
end

-------------------------------------------------------------------------------
-- Visited smarts (a client)
-------------------------------------------------------------------------------
local VISIT_RADIUS = 50 -- m, smart_terrain.script
local VISIT_EVERY_MS = 1000
local VISIT_RESCAN_MS = 30000 -- a map with no point found is looked at again after this
local visits = { next_at = 0, level = nil, tsmarts = nil, list = nil, scan_at = 0, errors = 0, tried = false }

-- { { name, id }, ... }: the points of `tsmarts` on map `here`. The simulation board first (a script class: a userdata; the smarts of
-- every map register there when their server object does): with anything on it its answer is final, a map with no point would be walked
-- every VISIT_RESCAN_MS for nothing. Before that the ALife copy: the objects of the current level of the smart clsid, else all.
local function find_smarts(tsmarts, here)
	local found = {}
	local board = rawget(_G, "SIMBOARD")
	local by_name = board and type(board.smarts_by_names) == "table" and board.smarts_by_names or nil
	if by_name and next(by_name) ~= nil then
		for name in pairs(tsmarts) do
			local se = by_name[name]
			if se and on_this_map(se, here) then found[#found + 1] = { name = name, id = se.id } end
		end
		return found
	end
	local sim = alife()
	local cls = rawget(_G, "clsid") and clsid.smart_terrain
	if not (sim and cls) then return found end
	local function take(se)
		local name = se:name()
		if tsmarts[name] and on_this_map(se, here) then found[#found + 1] = { name = name, id = se.id } end
		return false
	end
	pcall(function() sim:iterate_level_objects_of_clsid(cls, take) end)
	if #found == 0 then
		sim:iterate_objects(function(se)
			if se:clsid() == cls then take(se) end
			return false
		end)
	end
	return found
end

local function visit_tick()
	if not (core.is_client() and core.live() and db.actor) or core.is_map_server() then return end -- a map server's actor is a ghost
	local now = core.now()
	if now < visits.next_at then return end
	visits.next_at = now + VISIT_EVERY_MS
	local fft = rawget(_G, "game_fast_travel")
	if fft == nil and not visits.tried then
		visits.tried = true
		fft = core.mod("game_fast_travel")
	end
	local tsmarts = fft and fft.tsmarts
	if type(tsmarts) ~= "table" then return end
	local here = level_name()
	if visits.list == nil or visits.level ~= here or visits.tsmarts ~= tsmarts
		or (#visits.list == 0 and now >= visits.scan_at) then
		visits.level, visits.tsmarts, visits.scan_at = here, tsmarts, now + VISIT_RESCAN_MS
		visits.list = find_smarts(tsmarts, here)
	end
	if #visits.list == 0 then return end
	local sim = alife()
	local me = db.actor:position()
	if not (sim and me) then return end
	for _, v in ipairs(visits.list) do
		local se = sim:object(v.id)
		if se and se.position and me:distance_to(se.position) <= VISIT_RADIUS then
			SendScriptCallback("actor_on_interaction", "smarts", se, v.name)
		end
	end
end

-------------------------------------------------------------------------------
-- Fair Fast Travel: a trip without time
-------------------------------------------------------------------------------
-- game_fast_travel sends on_before_fast_travel(trip) right before it acts; with trip.notime it calls no advance_trip_time. A
-- player alone on his own machine travels as in single player (the host with nobody else in the session).
local function before_fast_travel(trip)
	if type(trip) ~= "table" or not core.live() then return end
	if not (core.is_client() or core.others_count() > 0) then return end
	if group.travel_takes_time() then return end
	trip.notime = true
end

-------------------------------------------------------------------------------
-- Update, status, start
-------------------------------------------------------------------------------
local function actor_on_update()
	local ok, err = pcall(visit_tick)
	if not ok and visits.errors < 3 then
		visits.errors = visits.errors + 1
		core.log("! smart visits: %s", tostring(err))
	end
	if asked and core.now() > asked.until_ms then close_offer() end -- nobody answered: he stays
	local w = watch
	if not w then return end
	if moved_check(w, WATCH_JUMP) or core.now() > w.until_ms then watch = nil end
end

function print_status()
	core.log("travel: teleports sent %d, followed %d, not followed %d, relayed %d | trips offered here %d, yes %d, no %d | routes out %d, in %d",
		stats.sent, stats.applied, stats.skipped, stats.relayed, stats.offered, stats.accepted, stats.declined, stats.routes_out,
		stats.routes_in)
end

-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop, and an
-- error here would skip all the scripts after this one, single player included (W5).
local function start_step(what, f)
	local ok, err = pcall(f)
	if not ok then printf("! [coop_economy_travel] %s failed: %s", what, tostring(err)) end
end

function on_game_start()
	if not core.engine() then return end
	start_step("install", install)
	register_events()
	RegisterScriptCallback("actor_on_update", actor_on_update)
	-- this script starts before game_fast_travel: a callback nobody has declared yet takes no listener (axr_main), so it is
	-- declared here as well; without Fair Fast Travel nobody ever sends it
	start_step("fair fast travel", function()
		-- when game_fast_travel was loaded first it is declared already: no second declaration (coop_route.declare)
		local okr, route = pcall(function() return coop_route end)
		if not (okr and type(route) == "table" and type(route.declare) == "function" and pcall(route.declare, "on_before_fast_travel")) then
			if type(AddScriptCallback) == "function" then AddScriptCallback("on_before_fast_travel") end
		end
		RegisterScriptCallback("on_before_fast_travel", before_fast_travel)
	end)
end
