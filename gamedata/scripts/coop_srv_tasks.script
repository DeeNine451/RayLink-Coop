-- Server (srv): the task code that only a server runs (step S5, unit A-S5T; docs/MODES.md, coop_tasks.script is the Core).
--[[
	Everything registers inside coop_mode.when_srv: in the co-op and in single player none of it runs.

	World server:
	  - a world hurt by a give that died (builds 45-49): a task whose on_init made a squad next to the player died on the world
	    server, and the dialog phrase had given its info already, so the dialog was closed for good. Its info is taken back once a
	    world (heal_lost_gives, at the first update; the world keeps that it looked: pstor coop_lost_gives). Was coop_tasks.
	  - a map server's personal effects (event coop_rep_map, from a map server's bridge only): run once per map server, effect epoch
	    and number (coop_tasks.map_seen, in the save) for the player whose character it names, then answered (coop_rep_map_ack).
	    Character 0 is the world server's seat, which plays no character: answered, run for nobody. Was coop_tasks.
	  - the recipients of task events sent by or to map servers.
	  - four effects of a task's end that landed on the world server's ghost (the quest audit 2026-11-13, temp/quest-audit/
	    functions.md rows 13-16; TZ section 2 "four small cases"):
	      play_sound_on_actor    (2 tasks, lttz_ms)        the player's machine plays it (coop_tasks.forward_fx)
	      actor_surge_immuned    (faction_base_defense)    task-end clear only; the level logic still sets the map server's flag
	      stalker_ceasefire      (2 tasks, lttz_ll, ...)   the truce with the player's faction, not the ghost's
	      is_faction_friend_to_actor (an offer's precondition, 1 task) the player's goodwill in the offer made on his level
	Map server:
	  - its own personal effects (coop_tasks send_effect sends them up) go up again once a second until the world server answers.
	  - the first two effects above, in a reward scope of its level's logic, go up the same way.
	A player's machine of a server: takes the two forwarded effects from the world server (coop_tasks.forward_allow).
--]]
local api = rawget(_G, "coop")

local FORWARDED = { "play_sound_on_actor", "actor_surge_immuned" }
local RETRY_MS = 1000
local MAX_PEER = 0xffff
local MAX_PAYLOAD = 15800
local MAX_PARAM = 256

-- Split levels, builds 45-49 (coop_srv_quests_far object_there handed the stock smart terrain a stand-in of the new squad). `info` is
-- taken back when the task is not on and none of the infos its own run sets (`ran`) is here. Once a world: a task dropped later is
-- the player's choice.
local LOST_GIVES = {
	{ info = "fanat_training_start_done", task = "task_fanat_training_1",
		ran = { "fanat_training_boars_death_done", "fanat_training_back_to_village_done", "esc_2_12_stalker_fanat_death" } },
	{ info = "cs_story_task0_ambush_renegade_start", task = "cs_task0_ambush_renegade_story",
		ran = { "renegade_cs_story_squad_1_death", "cs_story_task0_ambush_renegade_done" } },
	{ info = "cs_story_task0_ambush_renegade_done", task = "cs_task0_ambush_renegade_story2",
		ran = { "renegade_cs_story_squad_2_death", "cs_story_task0_ambush_renegade_done2" } },
	{ info = "cs_story_task0_ambush_renegade_done2", task = "cs_task0_ambush_renegade_story3",
		ran = { "renegade_cs_story_squad_3_death", "cs_story_task0_ambush_renegade_done3" } },
}

local state = { started = false, healed = false, retry_at = 0, errors = 0 }

local function log(fmt, ...)
	local ok, line = pcall(string.format, fmt, ...)
	printf("[coop-tasks] %s", ok and line or tostring(fmt))
end

local function report(what, err)
	state.errors = state.errors + 1
	if state.errors <= 10 or state.errors % 100 == 0 then log("! %s: %s", tostring(what), tostring(err)) end
end

local function guarded(what, f)
	return function(...)
		local ok, err = pcall(f, ...)
		if not ok then report(what, err) end
	end
end

local function tasks() return coop_tasks end

local function send(name, payload, target)
	local ok, sent = pcall(api.send_event, name, payload, target)
	return ok and sent == true
end

local function is_map_server()
	local ok, yes = pcall(function() return api.is_map_server ~= nil and api.is_map_server() == true end)
	return ok and yes == true
end

-- this process's own actor is no player (a world server's and a map server's ghost)
local function ghost()
	local m = coop_mode
	return type(m.actor_is_player) == "function" and m.actor_is_player() == false
end

local function players()
	local ok, list = pcall(api.players)
	return ok and type(list) == "table" and list or {}
end

local function map_servers()
	local ok, list = pcall(function() return api.levels.map_servers() end)
	return ok and type(list) == "table" and list or {}
end

local function has_talk_partner()
	local levels = api.levels
	return type(levels) == "table" and type(levels.talk_partner) == "function"
end

local function bridges()
	local out = {}
	for _, ms in ipairs(map_servers()) do
		if type(ms) == "table" and type(ms.bridge) == "number" then out[#out + 1] = ms.bridge end
	end
	return out
end

-- The taker of this map server's task, or a player standing on its map.
local function player_of_request(from, taker)
	if type(from) ~= "number" or from < 0x100 then return from end
	local lid
	for _, ms in ipairs(map_servers()) do
		if ms.bridge == from then lid = ms.level end
	end
	if not lid then return 0 end
	local level_of = api.levels.level_of_player
	if taker and taker ~= 0 and level_of(taker) == lid then return taker end
	for _, p in ipairs(players()) do
		if level_of(p.id) == lid then return p.id end
	end
	return 0
end

local function effect_route(effect, character)
	if not is_map_server() then return nil end
	effect.i, effect.e = character, state.epoch
	return "coop_rep_map", 0
end

local function tmgr()
	local mod = rawget(_G, "task_manager") or task_manager
	if not (mod and mod.get_task_manager) then return nil end
	local ok, tm = pcall(mod.get_task_manager)
	return ok and tm or nil
end

local function task_known(id)
	local ini = task_manager and task_manager.task_ini
	local ok, yes = pcall(function() return ini and ini:section_exist(id) end)
	return ok and yes == true
end

local function engine_task_running(id)
	local ok, t = pcall(function() return db.actor:get_task(id, true) end)
	return ok and t ~= nil
end

-------------------------------------------------------------------------------
-- World server: worlds hurt by a give that died
-------------------------------------------------------------------------------
function heal_lost_gives()
	local tm = tmgr()
	if not (tm and type(tm.task_info) == "table" and db.actor) then return 0 end
	local healed = 0
	for _, e in ipairs(LOST_GIVES) do
		-- the give that died left the task object in the journal with no task of the engine behind it: lost all the same
		local half = tm.task_info[e.task] ~= nil and not engine_task_running(e.task)
		local lost = has_alife_info(e.info) and task_known(e.task) and (tm.task_info[e.task] == nil or half)
		for _, info in ipairs(e.ran) do lost = lost and not has_alife_info(info) end
		if lost then
			if half then tm.task_info[e.task] = nil end
			db.actor:disable_info_portion(e.info)
			healed = healed + 1
			log("task '%s' was asked for and never given: info '%s' is taken back, its dialog offers it again", e.task, e.info)
		end
	end
	return healed
end

function _heal_once()
	if not (db.actor and coop_mode.decides_world()) then return end
	if load_var(db.actor, "coop_lost_gives", false) then return end
	save_var(db.actor, "coop_lost_gives", true)
	local ok, err = pcall(heal_lost_gives)
	if not ok then report("lost gives", err) end
end

-------------------------------------------------------------------------------
-- A map server's personal effects
-------------------------------------------------------------------------------
-- World server: is character `id` a player's (one in the session, or a member of the reward group who is away)? Character 0 is the
-- world server's seat, which plays no character.
local function member(id)
	if id == 0 then return false end
	for _, p in ipairs(players()) do
		if p.avatar_id == id then return true end
	end
	local rg = rawget(_G, "coop_reward_group")
	local ok, list = pcall(function() return rg and rg.list() or {} end)
	for _, m in ipairs(ok and type(list) == "table" and list or {}) do
		if type(m) == "table" and m.id == id then return true end
	end
	return false
end

local function whole(v, lo, hi) return type(v) == "number" and v >= lo and v <= hi and v % 1 == 0 end

local function text_field(v, lo, hi)
	return type(v) == "string" and #v >= lo and #v <= hi and not v:find("%c")
end

-- The statistics API takes deltas. Fractional adjustments are valid, infinities and values outside the signed range are not.
local function stat_value(v)
	return type(v) == "number" and v >= -2147483648 and v <= 2147483647
end

local function valid_effect(effect, ct)
	if not (text_field(effect.f, 1, 80) and text_field(effect.e, 1, 100) and whole(effect.q, 1, 2 ^ 31)
		and whole(effect.i, 0, 65534) and (effect.t == nil or text_field(effect.t, 0, 128))) then return false end
	local keys = { k = true, f = true, e = true, q = true, i = true, t = true }
	if effect.k == "stat" then
		if effect.f == "rank" or effect.f == "rept" then
			if not stat_value(effect.n) then return false end
			keys.n = true
		else
			if (effect.r ~= nil and not stat_value(effect.r)) or (effect.p ~= nil and not stat_value(effect.p)) then return false end
			keys.r, keys.p = true, true
		end
	elseif effect.k == "fx" and ct.forward_allowed(effect.f) then
		for i = 1, 4 do
			local key = "p" .. i
			if effect[key] ~= nil and not text_field(effect[key], 0, MAX_PARAM) then return false end
			keys[key] = true
		end
		if effect.f == "actor_surge_immuned" then
			if effect.p1 ~= nil and effect.p1 ~= "true" and effect.p1 ~= "false" then return false end
		elseif (effect.f == "drx_sl_change_factions" or effect.f == "play_sound_on_actor")
			and (effect.p1 == nil or effect.p1 == "") then return false end
	else
		return false
	end
	for key in pairs(effect) do if not keys[key] then return false end end
	return true
end

-- World server: event coop_rep_map from a map server's bridge (the sender comes from the transport): k = "stat" | "fx" (an effect
-- a player's machine runs), f its name, e the map server's epoch, q its number, i the character; the rest as coop_tasks sends it.
local function on_map_effect(payload, from)
	local sender = whole(from, 0x100, MAX_PEER) and coop_mode.from_level(from)
	if not coop_trust.pass("task_map_effect_sender", sender, "task effect from unexpected peer %s", tostring(from))
		or not sender then return end
	local size = type(payload) == "string" and #payload > 0 and #payload <= MAX_PAYLOAD
	if not coop_trust.pass("task_map_effect_size", size, "invalid task effect size from peer %s", tostring(from))
		or not size then return end
	local ct = tasks()
	local effect = ct.decode_payload(payload)
	local valid = valid_effect(effect, ct)
	if not coop_trust.pass("task_map_effect_payload", valid, "invalid task effect from peer %s", tostring(from))
		or not valid then return end
	local q = effect.q
	local key = tostring(from) .. ":" .. effect.e .. ":" .. tostring(q)
	local seen = ct.map_seen()
	if not seen[key] and member(effect.i) then
		ct.with_character(effect.i, function()
			effect.q, effect.e, effect.i = nil, nil, nil
			ct.send_personal(effect)
		end)
		seen[key] = true
	end
	-- answered also when it is nobody's: the map server stops sending it
	send("coop_rep_map_ack", tostring(q), from)
end

-- Map server: the world server's answer; that effect is off the list.
local function on_map_effect_ack(payload, from)
	local sender = from == 0
	if not coop_trust.pass("task_map_ack_sender", sender, "task effect ACK from unexpected peer %s", tostring(from))
		or not sender then return end
	local q = type(payload) == "string" and #payload <= 10 and tonumber(payload) or nil
	local valid = whole(q, 1, 2 ^ 31)
	if not coop_trust.pass("task_map_ack_payload", valid, "invalid task effect ACK from peer %s", tostring(from))
		or not valid then return end
	for _, wait in pairs(tasks().fx_pending()) do
		for i, e in ipairs(wait) do
			if e.q == q then
				table.remove(wait, i)
				return
			end
		end
	end
end

-- Map server: what the world server has not answered goes up again, once a second.
local function map_retry()
	local t = time_global()
	if t < state.retry_at then return end
	state.retry_at = t + RETRY_MS
	for _, wait in pairs(tasks().fx_pending()) do
		for _, e in ipairs(wait) do send("coop_rep_map", e.s, 0) end
	end
end

local function actor_on_update()
	if is_map_server() then map_retry() end
	if not state.healed and coop_mode.decides_world() and db.actor then
		state.healed = true
		_heal_once()
	end
end

-------------------------------------------------------------------------------
-- The four effects that landed on the ghost
-------------------------------------------------------------------------------
-- The character of the player the work being run now is for: a task's reward scope (coop_tasks.personal_character), else the far
-- view's scope of his level (an offer the world server makes for him, coop_srv_quests_far); nil: nobody's (the ghost's own).
local function player_character()
	local ct = tasks()
	local ok, id = pcall(ct.personal_character)
	if ok and whole(id, 1, 65534) then return id end
	local far = coop_srv_quests_far
	local oks, s = pcall(function() return far and far.in_scope and far.in_scope() end)
	local av = oks and type(s) == "table" and s.avatar or nil
	if whole(av, 1, 65534) then return av end
	return nil
end

function print_status()
	local pending = 0
	local ok, list = pcall(function() return tasks().fx_pending() end)
	for _, wait in pairs(ok and type(list) == "table" and list or {}) do pending = pending + #wait end
	log("server: started %s, lost gives looked at %s, effects waiting for the world server %d, errors %d", tostring(state.started),
		tostring(state.healed), pending, state.errors)
end

-------------------------------------------------------------------------------
-- Start: everything below runs only inside coop_mode.when_srv (check_layers L9)
-------------------------------------------------------------------------------
function on_game_start()
	if not api then return end
	coop_mode.when_srv(function()
		if state.started then return end
		state.started = true
		local ct = tasks()
		local world = coop_mode.decides_world()
		local map = is_map_server()
		for _, fname in ipairs(FORWARDED) do ct.forward_allow(fname) end
		coop_quests_core.set_part("task_delivery", {
			bridges = bridges,
			player_of_request = player_of_request,
			effect_route = effect_route,
			has_talk_partner = has_talk_partner,
		})
		if map then state.epoch = tostring(os.time()) .. ":" .. tostring(time_global()) .. ":" .. tostring({}) end
		local cm = rawget(_G, "coop_main") or coop_main
		if cm and cm.add_event_handler then
			if world then cm.add_event_handler("coop_rep_map", guarded("map personal effect", on_map_effect)) end
			if map then cm.add_event_handler("coop_rep_map_ack", guarded("map effect answer", on_map_effect_ack)) end
		else
			log("! coop_main.add_event_handler not found: a map server's personal effects are not taken")
		end
		RegisterScriptCallback("actor_on_update", actor_on_update)

		-- A ghost (world server, map server): the four effects that landed on it
		if not ghost() then return end
		local xe = rawget(_G, "xr_effects") or xr_effects
		local xc = rawget(_G, "xr_conditions") or xr_conditions
		if type(xe) ~= "table" then
			log("! xr_effects not found: a task's sound, surge flag and truce stay the ghost's")
			return
		end
		-- fn with the global `name` standing for `value` (the stock reads it at the call), put back after
		local function with_global(name, value, fn, ...)
			local saved = rawget(_G, name)
			_G[name] = value
			local res = { pcall(fn, ...) }
			_G[name] = saved
			if not res[1] then error(res[2], 0) end
			return unpack(res, 2)
		end
		-- the player's machine runs them: his sound, his own flag
		for _, fname in ipairs(FORWARDED) do
			local stock = xe[fname]
			if type(stock) == "function" then
				xe[fname] = function(actor, npc, p)
					if ct.forward_fx(fname, p) then return end
					return stock(actor, npc, p)
				end
			end
		end
		-- the truce with the faction of the player whose task ended
		local ceasefire = xe.stalker_ceasefire
		if type(ceasefire) == "function" then
			xe.stalker_ceasefire = function(...)
				local id = player_character()
				local cf = rawget(_G, "coop_faction")
				local okf, f = pcall(function() return id and cf and cf.faction_of_character(id) end)
				if not (okf and type(f) == "string" and f ~= "") then return ceasefire(...) end
				return with_global("get_actor_true_community", function() return f end, ceasefire, ...)
			end
		end
		-- the goodwill of the player an offer is made for (AC_ID: the stock asks the actor's)
		local friend = type(xc) == "table" and xc.is_faction_friend_to_actor
		if type(friend) == "function" then
			xc.is_faction_friend_to_actor = function(...)
				local id = player_character()
				if not id then return friend(...) end
				return with_global("AC_ID", id, friend, ...)
			end
		end
	end)
end
